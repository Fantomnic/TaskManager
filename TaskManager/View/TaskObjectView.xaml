<UserControl x:Class="TaskManager.View.TaskObjectView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskManager.View"
             xmlns:h="clr-namespace:TaskManager.Helpers"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <UserControl.Resources>
        <h:PriorityConverter x:Key="priorityConverter" />
        <h:StatusConverter x:Key="statusConverter" />
    </UserControl.Resources>
    
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
            <RowDefinition Height="*"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- Info -->
        <Border BorderThickness="1" BorderBrush="Black">
            <Grid Background="White">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition MinWidth="95" MaxWidth="140"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                    <RowDefinition MinHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="35"></RowDefinition>
                    <RowDefinition MinHeight="35"></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center">Info</TextBlock>

                <TextBlock Grid.Row="1" VerticalAlignment="Center" Margin="3,8,3,4">Дата создания:</TextBlock>
                <TextBlock Grid.Row="2" VerticalAlignment="Center" Margin="3,4,3,4">Приоритет:</TextBlock>
                <TextBlock Grid.Row="3" VerticalAlignment="Center" Margin="3,4,3,4">Статус:</TextBlock>

                <!-- OneWay, т.к. у свойства нет сеттера; TODO: ресурсы для null value -->
                <TextBox Grid.Row="1" Grid.Column="1" VerticalAlignment="Center" Margin="3,8,3,4" Focusable="False" Background="#FFFFFEDF" Text="{Binding Path=CreationDate,TargetNullValue=ОбъектНеЗадан,Mode=OneWay}"></TextBox>
                
                <!-- Приоритет -->
                <ComboBox x:Name="priorityList" Grid.Row="2" Grid.Column="1" VerticalAlignment="Center" Margin="3,4,3,4"
                          ItemsSource="{Binding Path=PriorityList}" SelectionChanged="PrioritySelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource priorityConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>

                <!-- Статус -->
                <ComboBox x:Name="statusList" Grid.Row="3" Grid.Column="1" VerticalAlignment="Center" Margin="3,4,3,4"
                            ItemsSource="{Binding Path=StatusList}" SelectionChanged="StatusSelectionChanged">
                    <ComboBox.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding Converter={StaticResource statusConverter}}"/>
                        </DataTemplate>
                    </ComboBox.ItemTemplate>
                </ComboBox>
                
                <TextBlock Grid.Row="1" Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right" Margin="3,8,3,4">Дата реализации:</TextBlock>
                <DatePicker Grid.Row="1" Grid.Column="3" VerticalAlignment="Center" HorizontalAlignment="Center" Margin="3,8,3,4" Focusable="False"></DatePicker>
            </Grid>
        </Border>

        <!-- Описание -->
        <Border Grid.Row="1" BorderThickness="1" BorderBrush="#FF1600FF">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="250"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center">Описание</TextBlock>
                <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="RightToLeft">
                    <Button x:Name="cancelButton" Margin="5,2,3,2" Visibility="Collapsed" Click="CancelEditDescription">Отменить</Button>
                    <Button x:Name="editButton" Margin="5,2,3,2" Click="EditDescription">Редактировать</Button>
                </StackPanel>

                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
                    <TextBox x:Name="descriptionField" TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#FFC8C8C8">15.08.2000</TextBox>
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- Комментарии -->
        <Border Grid.Row="2" BorderThickness="1" BorderBrush="#FF0CFF00">
            <Grid Background="White">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="150"></ColumnDefinition>
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="25"></RowDefinition>
                    <RowDefinition></RowDefinition>
                </Grid.RowDefinitions>

                <TextBlock VerticalAlignment="Center">Комментарии</TextBlock>
                <Button Grid.Column="1" Margin="3,2,3,2">Добавить комментарий</Button>
                <ScrollViewer Grid.Row="1" Grid.ColumnSpan="2" VerticalScrollBarVisibility="Auto">
                    <TextBox TextWrapping="Wrap" AcceptsReturn="True" IsReadOnly="True" Background="#FFC8C8C8">15.08.2000456екнекнапрпавк</TextBox>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
