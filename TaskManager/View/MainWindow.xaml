<Window x:Class="TaskManager.View.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager"
        xmlns:views="clr-namespace:TaskManager.View"
        xmlns:cmd="clr-namespace:TaskManager.Commands"
        xmlns:res="clr-namespace:TaskManager.Resources"
        mc:Ignorable="d"
        Title="Трекер задач" WindowStartupLocation="CenterScreen"
        Style="{StaticResource mainWindow}">
    <!-- WindowStartupLocation не является DependencyProperty, поэтому нельзя его задать через стиль -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="menuColumn" Width="0.3*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Выдвигающееся меню -->
        <ScrollViewer x:Name="menu" Panel.ZIndex="1" VerticalScrollBarVisibility="Auto" Background="#FF13E0E8"
                      Width="0" HorizontalAlignment="Left" MouseLeave="MenuMouseLeave">
            <StackPanel>
                <Button Style="{StaticResource menuButton}" Command="cmd:CommandsInstances.NewSectionCommand">Добавить раздел</Button>
                <Button Style="{StaticResource menuButton}">Кнопка 2</Button>
                <Button Style="{StaticResource menuButton}">Кнопка 3</Button>
                <Button Style="{StaticResource menuButton}">Кнопка 4</Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Рабочая зона -->
        <Grid x:Name="workspace" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.04*" MinWidth="30" MaxWidth="50"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню со значками -->
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Top" Style="{StaticResource menuButtonIcon}" ToolTip="Создать задачу"
                        Command="cmd:CommandsInstances.NewTaskCommand" CommandParameter="{Binding TasksList}">
                    <Image Style="{StaticResource menuImageIcon}" Source="/Resources/Images/GreenPlus.png"></Image>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource menuButtonIcon}" Click="MenuClick" ToolTip="Действия">
                    <Image Style="{StaticResource menuImageIcon}" Source="/Resources/Images/MenuIcon.png"></Image>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource menuButtonIcon}" Command="cmd:CommandsInstances.OpenSettingsCommand" ToolTip="Настройки">
                    <Image Style="{StaticResource menuImageIcon}" Source="/Resources/Images/SettingsIcon.png"></Image>
                </Button>
                <!-- TODO: Сделать значком -->
                <Button DockPanel.Dock="Bottom" Background="{x:Null}" BorderBrush="{x:Null}" Foreground="{x:Null}" Cursor="Help" Margin="0,0,0,5">
                    <TextBlock HorizontalAlignment="Center" TextDecorations="Underline" Foreground="#FF0034FF">Справка</TextBlock>
                </Button>
            </DockPanel>

            <!-- Задачи (заполняется в коде) -->
            <TabControl x:Name="sections" Grid.Column="1" SelectionChanged="SectionsSelectionChanged" />
        </Grid>
    </Grid>
</Window>
