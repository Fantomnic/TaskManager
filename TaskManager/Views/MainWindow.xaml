<local:CustomWindow x:Class="TaskManager.Views.MainWindow"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                    xmlns:local="clr-namespace:TaskManager.Views"
                    xmlns:ctrl="clr-namespace:TaskManager.CustomControls"
                    mc:Ignorable="d"
                    Title="Трекер задач" WindowStartupLocation="CenterScreen"
                    Style="{StaticResource MainWindow}"
                    Width="1000">
                    <!-- WindowStartupLocation не является DependencyProperty, поэтому нельзя его задать через стиль -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition x:Name="menuColumn" Width="0.3*"></ColumnDefinition>
            <ColumnDefinition Width="*"></ColumnDefinition>
        </Grid.ColumnDefinitions>

        <!-- Выдвигающееся меню -->
        <ScrollViewer x:Name="menu" Panel.ZIndex="1" VerticalScrollBarVisibility="Auto" Background="{DynamicResource MenuGradientBackground}"
                      Width="200" HorizontalAlignment="Left" MouseLeave="MenuMouseLeave">
            <StackPanel>
                <Button Style="{StaticResource MenuButton}" Command="{StaticResource NewSectionCommand}">Добавить раздел</Button>
                <Button Style="{StaticResource MenuButton}">
                    <Button.Content>
                        <Expander Style="{StaticResource MenuButton}" VerticalAlignment="Center">
                            <Expander.Header>
                                <TextBlock HorizontalAlignment="Center">Фильтры</TextBlock>
                            </Expander.Header>
                            <StackPanel>
                                <GroupBox Style="{StaticResource MenuGroupBox}">
                                    <StackPanel>
                                        <RadioButton Style="{StaticResource BaseMenuRadioButton}">Выделить по статусу</RadioButton>
                                        <RadioButton Style="{StaticResource BaseMenuRadioButton}">Выделить по приоритету</RadioButton>
                                        <RadioButton Style="{StaticResource BaseMenuRadioButton}" IsChecked="True">Не выделять цветом</RadioButton>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Style="{StaticResource MenuGroupBox}" Header="Отображать">
                                    <StackPanel>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}" IsChecked="True">Текущие</ctrl:CheckBoxWithItemStyle>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}" IsChecked="True">Отложенные</ctrl:CheckBoxWithItemStyle>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}" IsChecked="True">Отклонённые</ctrl:CheckBoxWithItemStyle>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}" IsChecked="True">Выполненные</ctrl:CheckBoxWithItemStyle>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}" IsChecked="True">Завершённые</ctrl:CheckBoxWithItemStyle>
                                    </StackPanel>
                                </GroupBox>
                                <GroupBox Style="{StaticResource MenuGroupBox}">
                                    <StackPanel>
                                        <ctrl:CheckBoxWithItemStyle Style="{StaticResource BaseMenuCheckBox}">Сегодняшние</ctrl:CheckBoxWithItemStyle>
                                    </StackPanel>
                                </GroupBox>
                            </StackPanel>
                        </Expander>
                    </Button.Content>
                </Button>
                <Button Style="{StaticResource MenuButton}">Кнопка 3</Button>
                <Button Style="{StaticResource MenuButton}">Кнопка 4</Button>
            </StackPanel>
        </ScrollViewer>

        <!-- Рабочая зона -->
        <Grid x:Name="workspace" Grid.ColumnSpan="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="0.04*" MinWidth="40" MaxWidth="60"></ColumnDefinition>
                <ColumnDefinition></ColumnDefinition>
            </Grid.ColumnDefinitions>

            <!-- Боковое меню со значками -->
            <DockPanel LastChildFill="False">
                <Button DockPanel.Dock="Top" Style="{StaticResource MenuButtonIcon}" ToolTip="Создать задачу"
                        Command="{StaticResource NewTaskCommand}" CommandParameter="{Binding TasksList}">
                    <Image Style="{DynamicResource NewTaskIcon}"/>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource MenuButtonIcon}" ToolTip="Действия"
                        Click="MenuClick">
                    <Image Style="{DynamicResource MenuActionsIcon}"></Image>
                </Button>
                <Button DockPanel.Dock="Top" Style="{StaticResource MenuButtonIcon}" ToolTip="Настройки"
                        Command="{StaticResource OpenSettingsCommand}">
                    <Image Style="{DynamicResource SettingsIcon}"></Image>
                </Button>
                <Button DockPanel.Dock="Bottom" Style="{StaticResource MenuButtonIcon}" ToolTip="Справка">
                    <Image Style="{DynamicResource AppInfoIcon}"></Image>
                </Button>
            </DockPanel>

            <!-- Задачи (разделы добавляются в коде) -->
            <TabControl x:Name="sections" Grid.Column="1"
                        SelectionChanged="SectionsSelectionChanged"
                        Background="{DynamicResource WindowBackground}">
                <TabItem x:Name="masterSection">
                    <TabItem.Header>
                        <TextBlock Style="{StaticResource MasterSectionHeaderContextMenu}" Text="{Binding Path=Name}"></TextBlock>
                    </TabItem.Header>
                    <ContentControl>
                        <local:MasterSectionView></local:MasterSectionView>
                    </ContentControl>
                </TabItem>
            </TabControl>
        </Grid>
    </Grid>
</local:CustomWindow>
