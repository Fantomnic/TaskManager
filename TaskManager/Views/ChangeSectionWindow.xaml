<local:WindowWithBottomButtons x:Class="TaskManager.Views.ChangeSectionWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:local="clr-namespace:TaskManager.Views"
                               xmlns:model="clr-namespace:TaskManager.Model"
                               xmlns:res="clr-namespace:TaskManager.Resources"
                               mc:Ignorable="d"
                               Title="Менеджер неосновного раздела задачи" WindowStartupLocation="CenterOwner"
                               Style="{StaticResource littleWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- TODO: Сделать GroupBox -->
        <StackPanel>
            <GroupBox BorderThickness="2" BorderBrush="Black" Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <TextBlock Grid.Row="1" Style="{StaticResource fieldDescription}">О задаче</TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="{x:Static res:Constants.DescriptonWidthGridLength}"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="{x:Static res:Constants.FieldAreaHeight}"></RowDefinition>
                        <RowDefinition MinHeight="{x:Static res:Constants.FieldAreaHeight}"></RowDefinition>
                        <RowDefinition MinHeight="{x:Static res:Constants.FieldAreaHeight}"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource fieldDescription}">Текущий раздел:</TextBlock>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource lineTextBoxWithHint}"
                             IsReadOnly="True"
                             Text="{Binding Path=AdditionalSectionViewModel.Name,TargetNullValue=Нет,Mode=OneWay}">
                    </TextBox>

                    <TextBlock Grid.Row="1" Style="{StaticResource fieldDescription}">Входит в задачу:</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource lineTextBoxWithHint}"
                             IsReadOnly="True"
                             Text="{Binding Path=ParentViewModel.Name,TargetNullValue=Нет,Mode=OneWay}">
                    </TextBox>

                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2"
                              Style="{StaticResource flowDirectionCheckBox}"
                              IsChecked="{Binding HasChildren,Mode=OneWay}"
                              IsEnabled="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left">Имеет подзадачи</CheckBox>
                </Grid>
            </GroupBox>

            <GroupBox BorderThickness="2" BorderBrush="Black" Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <RadioButton x:Name="changeButton" GroupName="sectionButtons" Style="{StaticResource baseStyleRadioButton}" IsChecked="True">Сменить раздел</RadioButton>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="108.435"></ColumnDefinition>
                        <ColumnDefinition Width="41.565"/>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="{x:Static res:Constants.FieldAreaHeight}"></RowDefinition>
                        <RowDefinition MinHeight="{x:Static res:Constants.FieldAreaHeight}"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource fieldDescription}" Grid.ColumnSpan="2" Margin="5,0,5,0">Переместить в</TextBlock>

                    <!-- Источник заполняем в коде -->
                    <ComboBox x:Name="newSectionsList" Grid.Column="2" IsEnabled="{Binding ElementName=changeButton,Path=IsChecked}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}"></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <CheckBox x:Name="transferFullChain"
                              Grid.Row="1" Grid.ColumnSpan="3"
                              IsEnabled="{Binding ElementName=changeButton,Path=IsChecked}"
                              Style="{StaticResource baseStyleCheckBox}" Margin="3,0,3,0">Перенести всю цепочку задач</CheckBox>
                </Grid>
            </GroupBox>

            <RadioButton x:Name="deleteButton" GroupName="sectionButtons"
                         Style="{StaticResource baseStyleRadioButton}"
                         Margin="{x:Static res:Constants.UniformMarginBase}">Удалить из текущего раздела</RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" FlowDirection="RightToLeft" Orientation="Horizontal">
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonCancelClick">Отмена</Button>
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonOKClick">OK</Button>
        </StackPanel>
    </Grid>
</local:WindowWithBottomButtons>
