<local:WindowWithBottomButtons x:Class="TaskManager.Views.ChangeSectionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:TaskManager.Views"
        xmlns:model="clr-namespace:TaskManager.Model"
        mc:Ignorable="d"
        Title="Менеджер неосновного раздела задачи" WindowStartupLocation="CenterOwner"
        Style="{StaticResource littleWindow}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
        </Grid.RowDefinitions>

        <!-- TODO: Сделать GroupBox --> 
        <StackPanel>
            <Border BorderThickness="1" BorderBrush="Black">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="35"></RowDefinition>
                        <RowDefinition MinHeight="35"></RowDefinition>
                        <RowDefinition MinHeight="35"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource fieldDescription}">Текущий раздел:</TextBlock>
                    <TextBox Grid.Column="1"
                             Style="{StaticResource lineTextBoxWithHint}"
                             IsReadOnly="True"
                             Text="{Binding Path=AdditionalSectionViewModel.Name,TargetNullValue=Нет,Mode=OneWay}">
                    </TextBox>

                    <TextBlock Grid.Row="1" Style="{StaticResource fieldDescription}">Входит в задачу:</TextBlock>
                    <TextBox Grid.Row="1" Grid.Column="1"
                             Style="{StaticResource lineTextBoxWithHint}"
                             IsReadOnly="True"
                             Text="{Binding Path=ParentViewModel.Name,TargetNullValue=Нет,Mode=OneWay}">
                    </TextBox>

                    <CheckBox Grid.Row="2" Grid.ColumnSpan="2"
                              Style="{StaticResource flowDirectionCheckBox}"
                              IsChecked="{Binding HasChildren,Mode=OneWay}"
                              IsHitTestVisible="False"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left">Имеет подзадачи</CheckBox>
                </Grid>
            </Border>

            <Separator Opacity="0" Height="10"/>
            <RadioButton x:Name="changeButton" Style="{StaticResource baseStyleRadioButton}" IsChecked="True">Сменить раздел:</RadioButton>

            <Border BorderThickness="1" BorderBrush="Black">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="150"></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition MinHeight="50"></RowDefinition>
                    </Grid.RowDefinitions>

                    <TextBlock Style="{StaticResource fieldDescription}" HorizontalAlignment="Center">Переместить в</TextBlock>
                    
                    <!-- Источник заполняем в коде -->
                    <ComboBox x:Name="newSectionsList" Grid.Column="1" IsEnabled="{Binding ElementName=changeButton,Path=IsChecked}" VerticalAlignment="Center">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}"></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </Border>

            <Separator Opacity="0" Height="10"/>
            <RadioButton x:Name="deleteButton" Style="{StaticResource baseStyleRadioButton}">Удалить из текущего раздела</RadioButton>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" FlowDirection="RightToLeft" Orientation="Horizontal">
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonCancelClick">Отмена</Button>
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonOKClick">OK</Button>
        </StackPanel>
    </Grid>
</local:WindowWithBottomButtons>
