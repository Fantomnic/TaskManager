<local:WindowWithBottomButtons x:Class="TaskManager.Views.SettingsWindow"
                               xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                               xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                               xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                               xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                               xmlns:local="clr-namespace:TaskManager.Views"
                               xmlns:model="clr-namespace:TaskManager.Model"
                               xmlns:h="clr-namespace:TaskManager.Helpers"
                               xmlns:res="clr-namespace:TaskManager.Resources"
                               mc:Ignorable="d"
                               Title="Настройки" WindowStartupLocation="CenterOwner"
                               Style="{StaticResource settingsWindow}">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition></RowDefinition>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
        </Grid.RowDefinitions>

        <StackPanel>
            <GroupBox Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource fieldDescription}" FontWeight="Bold">Разделы</TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.ColumnSpan="3"
                              Style="{StaticResource baseStyleCheckBox}"
                              IsChecked="{Binding SetDefaultSectionName}"
                              Checked="SetDefaultSectionNameChecked" Unchecked="SetDefaultSectionNameUnchecked">Заполнять наименование раздела по умолчанию</CheckBox>
                    <CheckBox x:Name="incrementSectionName" Grid.Row="1" Grid.ColumnSpan="3"
                              Style="{StaticResource baseStyleCheckBox}"
                              IsChecked="{Binding IncrementSectionName}">Инкрементировать</CheckBox>

                    <TextBlock Grid.Row="2" Style="{StaticResource fieldDescription}" Grid.ColumnSpan="2" Margin="5,0,5,0">Наименование:</TextBlock>
                    <TextBox x:Name="sectionName" Grid.Row="2" Grid.Column="2"
                             Style="{StaticResource baseStyleAlignmentTextBox}" Text="{Binding DefaultSectionName}" Margin="3,0,3,0"></TextBox>
                </Grid>
            </GroupBox>

            <GroupBox Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource fieldDescription}" FontWeight="Bold">Задачи</TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <Grid.RowDefinitions>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                        <RowDefinition></RowDefinition>
                    </Grid.RowDefinitions>

                    <CheckBox Grid.ColumnSpan="2"
                              Style="{StaticResource baseStyleCheckBox}"
                              IsChecked="{Binding SetDefaultTaskName}"
                              Checked="SetDefaultTaskNameChecked" Unchecked="SetDefaultTaskNameUnchecked">Заполнять наименование задачи по умолчанию</CheckBox>
                    <CheckBox x:Name="incrementTaskName" Grid.Row="1" Grid.ColumnSpan="2"
                              Style="{StaticResource baseStyleCheckBox}"
                              IsChecked="{Binding IncrementTaskName}">Инкрементировать</CheckBox>

                    <TextBlock Grid.Row="2" Style="{StaticResource fieldDescription}">Наименование:</TextBlock>
                    <TextBox x:Name="taskName" Grid.Row="2" Grid.Column="1"
                             Style="{StaticResource baseStyleAlignmentTextBox}" Text="{Binding DefaultTaskName}"></TextBox>
                </Grid>
            </GroupBox>

            <GroupBox Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource fieldDescription}" FontWeight="Bold">Шрифт</TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="2" Style="{StaticResource fieldDescription}">Доступные масштабы:</TextBlock>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource BaseComboBoxStyle}"
                              ItemsSource="{x:Static model:Settings.AvailableFonts}"
                              SelectedItem="{Binding FontSettings}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource baseStyleAlignmentMargin}"
                                           Text="{Binding Path=ID,Converter={StaticResource fontIDConverter}}"
                                           FontSize="{Binding Path=BaseFont}">
                                    <TextBlock.ToolTip>
                                        <TextBlock Text="{Binding Path=BaseFont, StringFormat=\{0\} pt}"></TextBlock>
                                    </TextBlock.ToolTip>
                                </TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </GroupBox>

            <GroupBox Margin="{x:Static res:Constants.UniformMarginBase}">
                <GroupBox.Header>
                    <TextBlock Style="{StaticResource fieldDescription}" FontWeight="Bold">Тема</TextBlock>
                </GroupBox.Header>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition></ColumnDefinition>
                        <ColumnDefinition></ColumnDefinition>
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Row="2" Style="{StaticResource fieldDescription}">Доступные темы:</TextBlock>
                    <ComboBox Grid.Column="1"
                              Style="{StaticResource BaseComboBoxStyle}"
                              ItemsSource="{x:Static h:Enums.AllThemes}"
                              SelectedItem="{Binding Path=Theme}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource baseStyleAlignmentMargin}" Text="{Binding Converter={StaticResource themeConverter}}"></TextBlock>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </Grid>
            </GroupBox>
        </StackPanel>

        <StackPanel Grid.Column="1">
            <CheckBox>Тест 1</CheckBox>
        </StackPanel>

        <StackPanel Grid.Row="1" Grid.ColumnSpan="2" FlowDirection="RightToLeft" Orientation="Horizontal">
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonCancelClick">Отмена</Button>
            <Button Style="{StaticResource serviceButtonWithStandartWidth}" Click="ButtonOKClick">Применить</Button>
        </StackPanel>
    </Grid>
</local:WindowWithBottomButtons>
