<local:SectionView x:Class="TaskManager.Views.AdditionalSectionView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TaskManager.Views"
                   xmlns:model="clr-namespace:TaskManager.Model"
                   xmlns:res="clr-namespace:TaskManager.Resources"
                   xmlns:ctrl="clr-namespace:TaskManager.CustomControls"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="{x:Static res:Constants.MinTasksListWidth}"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition MinWidth="{x:Static res:Constants.MinTaskPropertyWidth}"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <Border Background="{DynamicResource WindowBackground}" Panel.ZIndex="1" BorderThickness="0 0 1 0" BorderBrush="{Binding ElementName=tasksTree,Path=BorderBrush}">
            <TextBlock Style="{StaticResource TitleDescription}">Список задач</TextBlock>
        </Border>

        <ctrl:StretchingTreeView x:Name="tasksTree" Grid.Row="1" Panel.ZIndex="1"
                                 ItemsSource="{Binding VisibleRootTasksViewModels}"
                                 ItemContainerStyle="{StaticResource AdditionalTaskItem}"
                                 SelectedItemChanged="StretchingTreeViewSelectedItemChanged"
                                 MouseDown="TasksContainerMouseDown"
                                 Background="{DynamicResource InnerBackground}"
                                 Padding="{x:Static res:Constants.UniformMarginBase}">
            <ctrl:StretchingTreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Path=ChildrenViewModels}">
                    <TextBlock Style="{StaticResource TaskItemWithTextIndication}" Text="{Binding Path=Name}"></TextBlock>
                </HierarchicalDataTemplate>
            </ctrl:StretchingTreeView.ItemTemplate>
        </ctrl:StretchingTreeView>

        <GridSplitter Grid.Column="1" Grid.RowSpan="2" Panel.ZIndex="1" ShowsPreview="False" Width="3" Focusable="False"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource WindowBackground}"/>

        <TabControl x:Name="taskInfo" Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource WindowBackground}"
                    ItemsSource="{StaticResource TaskTabHeaders}">
        </TabControl>

        <!-- Когда нет выбранного объекта, включается отображение этого ЭУ  -->
        <Canvas x:Name="emptyTaskImage" Grid.ColumnSpan="3" Grid.RowSpan="2" Style="{StaticResource EmptyTaskStyle}"></Canvas>
    </Grid>
</local:SectionView>
