<local:SectionView x:Class="TaskManager.Views.AdditionalSectionView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TaskManager.Views"
                   xmlns:model="clr-namespace:TaskManager.Model"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800">
    
    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="300"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition MinWidth="400"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource titleDescription}">Список задач</TextBlock>

        <local:StretchingTreeView Grid.Row="1"
                                  ItemsSource="{Binding RootTasksViewModels}"
                                  ItemContainerStyle="{StaticResource tasksAdditionalContextMenu}"
                                  SelectedItemChanged="StretchingTreeViewSelectedItemChanged"
                                  MouseDown="TasksContainerMouseDown"
                                  Background="{DynamicResource innerBackground}">
            <local:StretchingTreeView.ItemTemplate>
                <HierarchicalDataTemplate ItemsSource="{Binding Path=ChildrenViewModels}">
                    <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}" Background="Transparent"></TextBlock>
                </HierarchicalDataTemplate>
            </local:StretchingTreeView.ItemTemplate>
        </local:StretchingTreeView>

        <GridSplitter Grid.Row="1" Grid.Column="1" ShowsPreview="False" Width="3"
                      HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource windowBackground}"/>

        <TabControl x:Name="taskInfo" Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource windowBackground}"
                    ItemsSource="{StaticResource tasksTabHeaders}">
        </TabControl>

        <!-- Когда нет выбранного объекта, включается отображение этого ЭУ -->
        <Image x:Name="emptyTaskImage" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource emptyTaskImageStyle}"></Image>
    </Grid>
</local:SectionView>
