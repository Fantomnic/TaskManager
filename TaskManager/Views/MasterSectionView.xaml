<local:SectionView x:Class="TaskManager.Views.MasterSectionView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TaskManager.Views"
                   xmlns:model="clr-namespace:TaskManager.Model"
                   xmlns:res="clr-namespace:TaskManager.Resources"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*" MinWidth="{x:Static res:Constants.MinTasksListWidth}"></ColumnDefinition>
            <ColumnDefinition Width="Auto"></ColumnDefinition>
            <ColumnDefinition MinWidth="{x:Static res:Constants.MinTaskPropertyWidth}"></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleDescription}">Список задач</TextBlock>

        <ListBox x:Name="tasksList" Grid.Row="1"
                 ItemsSource="{Binding VisibleTasksViewModels}"
                 SelectedItem="{Binding SelectedTaskViewModel}"
                 ItemContainerStyle="{StaticResource MasterTaskItem}"
                 MouseDown="TasksContainerMouseDown"
                 ContextMenuOpening="TasksListContextMenuOpening"
                 Background="{DynamicResource InnerBackground}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource BaseStyleAlignment}" Text="{Binding Path=Name}" Margin="8,0,0,0"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <GridSplitter Grid.Row="1" Grid.Column="1" ShowsPreview="False" Width="3"
              HorizontalAlignment="Center" VerticalAlignment="Stretch" Background="{DynamicResource WindowBackground}"/>
        
        <TabControl x:Name="taskInfo" Grid.Column="2" Grid.RowSpan="2" Background="{DynamicResource WindowBackground}"
                    ItemsSource="{StaticResource TaskTabHeaders}">
        </TabControl>

        <!-- Когда нет выбранного объекта, включается отображение этого ЭУ -->
        <Image x:Name="emptyTaskImage" Grid.Column="2" Grid.RowSpan="2" Style="{StaticResource EmptyTaskImageStyle}"></Image>
    </Grid>
</local:SectionView>
