<local:SectionView x:Class="TaskManager.Views.MasterSectionView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TaskManager.Views"
                   xmlns:model="clr-namespace:TaskManager.Model"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource titleDescription}">Список задач</TextBlock>

        <ListBox x:Name="tasksList" Grid.Row="1"
                 ItemsSource="{Binding AllTasksViewModels}"
                 SelectedItem="{Binding SelectedTaskViewModel}"
                 ItemContainerStyle="{StaticResource tasksMasterContextMenu}"
                 MouseDown="TasksContainerMouseDown"
                 ContextMenuOpening="TasksListContextMenuOpening"
                 Background="{DynamicResource innerBackground}">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}" Margin="8,0,0,0"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TabControl x:Name="taskInfo" Grid.Column="1" Grid.RowSpan="2" Background="{DynamicResource windowBackground}"
                    ItemsSource="{StaticResource tasksTabHeaders}">
        </TabControl>

        <!-- Когда нет выбранного объекта, включается отображение этого ЭУ -->
        <Image x:Name="emptyTaskImage" Grid.Column="1" Grid.RowSpan="2" Style="{StaticResource emptyTaskImageStyle}"></Image>
    </Grid>
</local:SectionView>
