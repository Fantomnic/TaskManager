<local:SectionView x:Class="TaskManager.Views.MasterSectionView"
                   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                   xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
                   xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
                   xmlns:local="clr-namespace:TaskManager.Views"
                   xmlns:model="clr-namespace:TaskManager.Model"
                   mc:Ignorable="d"
                   d:DesignHeight="450" d:DesignWidth="800">

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="1.1*"></ColumnDefinition>
            <ColumnDefinition></ColumnDefinition>
        </Grid.ColumnDefinitions>
        <Grid.RowDefinitions>
            <RowDefinition Height="{Binding Source={x:Static model:Settings.FontSettings},Path=ButtonAreaHeight}"></RowDefinition>
            <RowDefinition></RowDefinition>
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource titleDescription}" Background="White">Список задач</TextBlock>
        
        <ListBox x:Name="tasksList" Grid.Row="1"
                 ItemsSource="{Binding AllTasksViewModels}"
                 SelectedItem="{Binding SelectedTaskViewModel}"
                 ItemContainerStyle="{StaticResource tasksMasterContextMenu}"
                 MouseDown="TasksContainerMouseDown"
                 ContextMenuOpening="TasksListContextMenuOpening">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <TextBlock Style="{StaticResource baseTextBlock}" Text="{Binding Path=Name}"/>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <TabControl x:Name="taskInfo" Grid.Column="1" Grid.RowSpan="2">
            <TabItem>
                <TabItem.Header>
                    <TextBlock Style="{StaticResource baseTextBlock}">Info</TextBlock>
                </TabItem.Header>
                <local:TaskObjectView DataContext="{Binding Path=SelectedTaskViewModel}"></local:TaskObjectView>
            </TabItem>

            <TabItem>
                <TabItem.Header>
                    <TextBlock Style="{StaticResource baseTextBlock}">Файлы</TextBlock>
                </TabItem.Header>
            </TabItem>
        </TabControl>

        <!-- Когда нет выбранного объекта, включается отображение этого ЭУ -->
        <Image x:Name="emptyTaskImage" Grid.Column="1" Grid.RowSpan="2" Visibility="{Binding Path=VisibilityEmptyTaskImage}" Source="/Resources/Images/QuestionPromo.png" Stretch="Fill"></Image>
    </Grid>
</local:SectionView>
