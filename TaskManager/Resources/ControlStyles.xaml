<ResourceDictionary x:Class="TaskManager.Resources.ControlStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TaskManager.Views"
                    xmlns:local="clr-namespace:TaskManager.Resources"
                    xmlns:model="clr-namespace:TaskManager.Model"
                    xmlns:ctrl="clr-namespace:TaskManager.CustomControls"
                    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib">

    <!-- Стиль для всех заголовков вкладок -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"></Setter>
        <Setter Property="BorderThickness" Value="1.5, 1.5, 1.5, 0"></Setter>
        <Setter Property="Template" Value="{StaticResource TabItemTemplate}"></Setter>
    </Style>

    <!-- Стиль групбокса (общий) -->
    <Style TargetType="GroupBox" x:Key="BaseGroupBox">
        <Setter Property="Template" Value="{StaticResource GroupBoxTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource InnerBackground}"></Setter>
        <Setter Property="BorderThickness" Value="2"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource BlackGrayBorder}"></Setter>
        <Setter Property="Margin" Value="{x:Static local:Constants.UniformMarginBase}"></Setter>
        <Setter Property="Focusable" Value="False"></Setter>
    </Style>

    <!-- Стиль групбокса для настроек -->
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseGroupBox}" x:Key="SettingsGroupBox">
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль групбокса для выдвигающегося меню -->
    <Style TargetType="GroupBox" BasedOn="{StaticResource BaseGroupBox}" x:Key="MenuGroupBox">
        <Setter Property="Background" Value="Transparent"></Setter>
        <Setter Property="BorderBrush" Value="{DynamicResource TextForeground}"></Setter>
    </Style>

    <!-- Стиль для "статических" кнопок меню в боковой панели -->
    <Style TargetType="Button" x:Key="MenuButtonIcon">
        <Setter Property="Template" Value="{StaticResource MenuButtonTemplate}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource BlackGrayBorder}"></Setter>
        <Setter Property="Background" Value="{x:Null}"></Setter>
        <Setter Property="BorderThickness" Value="2"></Setter>
        <Setter Property="Margin" Value="2"></Setter>
    </Style>

    <!-- Общий стиль задачи списка -->
    <Style TargetType="ListBoxItem" x:Key="BaseTaskListItem">
        <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}"></Setter>
        <Setter Property="BorderThickness" Value="1.5"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static model:Settings.Instanse},Path=IndicateByStatus}" Value="True">
                <Setter Property="Background" Value="{Binding Path=TaskStatus.Background}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>
    
    <!-- Стиль элемента списка (основной раздел) -->
    <Style TargetType="ListBoxItem" BasedOn="{StaticResource BaseTaskListItem}" x:Key="MasterTaskItem">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <!-- У меню DataContext - это TaskObjectViewModel (элемент списка) -->
                <ContextMenu>
                    <MenuItem Style="{StaticResource ShowTaskPropertyCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource ChangeSectionCommandMenuItem}" IsEnabled="{Binding ChangeSectionEnabled}"></MenuItem>
                    <MenuItem Style="{StaticResource AcceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource RejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DeferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DoneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource CompleteCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DeleteTaskCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                <Setter Property="BorderBrush" Value="Red"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль элемента дерева (неосновной раздел) -->
    <Style TargetType="ctrl:StretchingTreeViewItem" x:Key="AdditionalTaskItem">
        <Setter Property="Template" Value="{StaticResource TreeViewItemTemplate}"></Setter>
        <Setter Property="IsExpanded" Value="True"></Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource ShowTaskPropertyCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource ChangeSectionCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource AcceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource RejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DeferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DoneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource CompleteCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource MakeRootCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        <Setter Property="AllowDrop" Value="True"></Setter>

        <!-- Drag&Drop -->
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="PreviewMouseRightButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewMouseLeftButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseMove" Handler="PreviewMouseMoveItem"></EventSetter>
        <EventSetter Event="Drop" Handler="DropItem"></EventSetter>

        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static model:Settings.Instanse},Path=IndicateByStatus}" Value="True">
                <Setter Property="Background" Value="{Binding Path=TaskStatus.Background}"></Setter>
            </DataTrigger>
            <DataTrigger Binding="{Binding IsExpired}" Value="True">
                <Setter Property="BorderBrush" Value="Red"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль, отвечающий за отображение "пустой" задачи -->
    <Style TargetType="Image" x:Shared="False" x:Key="EmptyTaskImageStyle">
        <Setter Property="Visibility" Value="{Binding Path=VisibilityEmptyTaskImage}"></Setter>
        <Setter Property="Source" Value="/Resources/Images/QuestionPromo.png"></Setter>
        <Setter Property="Stretch" Value="Fill"></Setter>
    </Style>

    <!-- Стиль, отвечающий за отображение "пустой" задачи (фона) -->
    <Style TargetType="Canvas" x:Shared="False" x:Key="EmptyTaskStyle">
        <Setter Property="Visibility" Value="{Binding Path=VisibilityEmptyTaskImage}"></Setter>
        <Setter Property="Background">
            <Setter.Value>
                <ImageBrush ImageSource="{DynamicResource ImageBackgroundPath}" Stretch="UniformToFill" TileMode="Tile" Viewport="0,0,0.5,1"/>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль элемента комбобокса (в выпадающем списке) -->
    <Style TargetType="ComboBoxItem" x:Key="ComboBoxItem">
        <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}"></Setter>
    </Style>

    <!-- Стиль комбобокса (общий) -->
    <Style TargetType="ComboBox" x:Key="BaseComboBox">
        <Setter Property="Template" Value="{StaticResource ComboBoxTemplate}"></Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem}"></Setter>
        <Setter Property="MinWidth" Value="150"></Setter>
    </Style>

    <!-- Стиль чекбокса (общий) -->
    <Style TargetType="ctrl:CheckBoxWithItemStyle" BasedOn="{StaticResource BaseStyleAlignmentMargin}" x:Key="BaseCheckBox">
        <Setter Property="Template" Value="{StaticResource CheckBoxTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Margin" Value="1"/>
        <Setter Property="TextBlockStyle" Value="{StaticResource BaseStyleAlignmentMargin}"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <!-- Стиль чекбокса, у которого галочка справа -->
    <!-- Ставим галочку справа и переворачиваем направление внутри самого чекбокса (иначе галочка будет отзеркалена) -->
    <Style TargetType="ctrl:CheckBoxWithItemStyle" BasedOn="{StaticResource BaseCheckBox}" x:Key="FlowDirectionCheckBox">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Style.Resources>
            <Style TargetType="Path">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
        </Style.Resources>
    </Style>

    <!-- Стиль чекбокса для выдвигающегося меню -->
    <Style TargetType="ctrl:CheckBoxWithItemStyle" BasedOn="{StaticResource BaseCheckBox}" x:Key="BaseMenuCheckBox">
        <Setter Property="TextBlockStyle" Value="{StaticResource TextsMenuStyle}"></Setter>
    </Style>

    <!-- Стиль радиокнопки (общий) -->
    <!-- Тут не получится так же, как с чекбоксом, т.к. здесь нет объекта Path -->
    <Style TargetType="RadioButton" BasedOn="{StaticResource BaseScale}" x:Key="BaseRadioButton">
        <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Setter Property="FontSize" Value="{x:Static local:Constants.StandartBaseFont}"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"></Setter>
    </Style>

    <!-- Стиль радиокнопки для выдвигающегося меню -->
    <Style TargetType="RadioButton" BasedOn="{StaticResource MenuTextsScale}" x:Key="BaseMenuRadioButton">
        <Setter Property="Template" Value="{StaticResource RadioButtonTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Setter Property="FontSize" Value="{x:Static local:Constants.StandartMenuFont}"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"></Setter>
    </Style>

    <!-- Стиль текстбокса (общий) -->
    <Style TargetType="TextBox" BasedOn="{StaticResource BaseStyle}" x:Key="BaseTextBox">
        <Setter Property="Template" Value="{StaticResource TextBoxTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource FieldBackgroundReadOnly}"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}" x:Key="BaseTextBoxAlignment">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxAlignment}" x:Key="BaseTextBoxAlignmentMargin">
        <Setter Property="Margin" Value="3,0,3,0"></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxAlignmentMargin}" x:Key="FullReadOnlyLine">
        <Setter Property="IsReadOnly" Value="True"></Setter>
        <Setter Property="Focusable" Value="False"></Setter>
        <Setter Property="Cursor" Value="Arrow"></Setter>
    </Style>

    <!-- Стиль для изменения цвета текста в соответствии с приоритетом -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseStyleAlignment}" x:Key="TaskItemWithTextIndication">
        <Setter Property="Focusable" Value="False"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static model:Settings.Instanse},Path=IndicateByPriority}" Value="True">
                <Setter Property="Foreground" Value="{Binding Path=VisibleTaskPriority.Foreground}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для "кнопок" выдвигающегся меню -->
    <Style TargetType="ContentControl" BasedOn="{StaticResource BaseMenuStyle}" x:Key="MenuButtonCommon">
        <Setter Property="BorderThickness" Value="3"></Setter>
        <Setter Property="Background" Value="{Binding ElementName=menu,Path=Background}"></Setter>
        <Setter Property="BorderBrush" Value="Transparent"></Setter>
        <Setter Property="MinHeight" Value="{x:Static local:Constants.MenuButtonHeight}"></Setter>
        <Setter Property="Width" Value="{Binding ElementName=menu,Path=Width}"></Setter>
    </Style>

    <!-- Стиль для кнопок выдвигающегся меню -->
    <!--TODO: Сделать конвертер для задания пропорциональной высоты кнопки относительно панели-->
    <Style TargetType="Button" BasedOn="{StaticResource MenuButtonCommon}" x:Key="MenuButton">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{DynamicResource MenuButtonIsMouseOverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource MenuButtonIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Background" Value="{DynamicResource ButtonIsPressedBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Стиль для служебных кнопок приложения (ОК, Отмена и т.п.) -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseStyle}" x:Key="ServiceButton">
        <Setter Property="Template" Value="{StaticResource ButtonTemplate}"/>
        <Setter Property="BorderThickness" Value="1.5"></Setter>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"></Setter>
        <Setter Property="Margin" Value="3,2,3,2"></Setter>
        <Setter Property="MinWidth" Value="100"></Setter>
        <Setter Property="MaxWidth" Value="200"></Setter>
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter Property="Background" Value="{DynamicResource ButtonIsMouseOverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsFocused" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="true">
                <Setter Property="Background" Value="{DynamicResource ButtonIsPressedBackground}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!-- Базовые шаблоны: https://www.cyberforum.ru/wpf-silverlight/thread2489276.html?ysclid=mobxksrent316690816 -->
    <Style TargetType="{x:Type CalendarItem}" BasedOn="{StaticResource BaseStyle}" x:Key="BaseCalendarItem">
        <Setter Property="Margin" Value="0,3,0,3"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarItem}">
                    <ControlTemplate.Resources>
                        <!-- Строка с днями недели -->
                        <DataTemplate x:Key="{x:Static CalendarItem.DayTitleTemplateResourceKey}">
                            <TextBlock Style="{StaticResource BaseTextForeground}"
                                       Foreground="{DynamicResource TitleForeground}"
                                       FontWeight="Bold"
                                       FontFamily="Verdana"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       Margin="0,6,0,6"
                                       Text="{Binding}">
                            </TextBlock>
                        </DataTemplate>
                    </ControlTemplate.Resources>
                    <Grid x:Name="PART_Root">
                        <Grid.Resources>
                            <SolidColorBrush x:Key="DisabledColor" Color="#A5FFFFFF"/>
                        </Grid.Resources>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="PART_DisabledVisual"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}" CornerRadius="1">
                            <Border BorderBrush="#FFFFFFFF" BorderThickness="2" CornerRadius="1">
                                <Grid>
                                    <Grid.Resources>
                                        <ControlTemplate x:Key="PreviousButtonTemplate" TargetType="{x:Type Button}">
                                            <Grid Cursor="Hand">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <!--<Storyboard>
                                                                <ColorAnimation Duration="0" To="Red"
                                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                                Storyboard.TargetName="path"/>
                                                            </Storyboard>-->
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="(Shape.Fill).(Brush.Opacity)" Storyboard.TargetName="path"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Rectangle Fill="#11E5EBF1" Opacity="1" Stretch="Fill"/>
                                                <Grid>
                                                    <Path x:Name="path" Data="M288.75,232.25 L288.75,240.625 L283,236.625 z"
                                                          Fill="{DynamicResource TextForeground}"
                                                          HorizontalAlignment="Left" Height="10" Margin="14,-6,0,0" Stretch="Fill" VerticalAlignment="Center" Width="6">
                                                    </Path>
                                                </Grid>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="path" Property="Fill" Value="{DynamicResource TitleForeground}"></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                        <ControlTemplate x:Key="NextButtonTemplate" TargetType="{x:Type Button}">
                                            <Grid Cursor="Hand">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                           <!--<Storyboard>
                                                                <ColorAnimation Duration="0" To="#FF73A9D8"
                                                                                Storyboard.TargetProperty="(Shape.Fill).(SolidColorBrush.Color)"
                                                                                Storyboard.TargetName="path"/>
                                                            </Storyboard>-->
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="(Shape.Fill).(Brush.Opacity)" Storyboard.TargetName="path"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <Rectangle Fill="#11E5EBF1" Opacity="1" Stretch="Fill"/>
                                                <Grid>
                                                    <Path x:Name="path" Data="M282.875,231.875 L282.875,240.375 L288.625,236 z"
                                                          Fill="{DynamicResource TextForeground}"
                                                          HorizontalAlignment="Right" Height="10" Margin="0,-6,14,0" Stretch="Fill" VerticalAlignment="Center" Width="6"/>
                                                </Grid>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="path" Property="Fill" Value="{DynamicResource TitleForeground}"></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                        <ControlTemplate x:Key="HeaderButtonTemplate" TargetType="{x:Type Button}">
                                            <Grid Cursor="Hand">
                                                <VisualStateManager.VisualStateGroups>
                                                    <VisualStateGroup x:Name="CommonStates">
                                                        <VisualState x:Name="Normal"/>
                                                        <VisualState x:Name="MouseOver">
                                                            <!--<Storyboard>
                                                                <ColorAnimation Duration="0" To="#FF73A9D8"
                                                                                Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                                                Storyboard.TargetName="buttonContent"/>
                                                            </Storyboard>-->
                                                        </VisualState>
                                                        <VisualState x:Name="Disabled">
                                                            <Storyboard>
                                                                <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="buttonContent"/>
                                                            </Storyboard>
                                                        </VisualState>
                                                    </VisualStateGroup>
                                                </VisualStateManager.VisualStateGroups>
                                                <ContentPresenter x:Name="buttonContent" ContentTemplate="{TemplateBinding ContentTemplate}"
                                                                  Content="{TemplateBinding Content}"
                                                                  TextElement.Foreground="{DynamicResource TextForeground}"
                                                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                                  Margin="1,4,1,9"
                                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                                            </Grid>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="buttonContent" Property="TextElement.Foreground" Value="{DynamicResource TitleForeground}"></Setter>
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Grid.Resources>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto"/>
                                        <RowDefinition Height="*"/>
                                    </Grid.RowDefinitions>
                                    <Button x:Name="PART_PreviousButton" Grid.Column="0" Focusable="False" HorizontalAlignment="Left" Height="20" Grid.Row="0"
                                            Template="{StaticResource PreviousButtonTemplate}" Width="28"/>
                                    <!-- Центральная верхняя кнопка с текущим периодом -->
                                    <Button x:Name="PART_HeaderButton"
                                            Grid.Column="1" Grid.Row="0"
                                            FontWeight="Bold"
                                            Focusable="False"
                                            Foreground="{DynamicResource TextForeground}"
                                            FontSize="{Binding Source={x:Static model:Settings.FontSettings},Path=TitleFont}"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Template="{StaticResource HeaderButtonTemplate}"/>
                                    <Button x:Name="PART_NextButton" Grid.Column="2" Focusable="False" HorizontalAlignment="Right" Height="20" Grid.Row="0"
                                            Template="{StaticResource NextButtonTemplate}" Width="28"/>
                                    <Grid x:Name="PART_MonthView" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="6,-1,6,6" Grid.Row="1" Visibility="Visible">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                    <Grid x:Name="PART_YearView" Grid.ColumnSpan="3" HorizontalAlignment="Center" Margin="6,-3,7,6" Grid.Row="1" Visibility="Hidden">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                            <RowDefinition Height="Auto"/>
                                        </Grid.RowDefinitions>
                                    </Grid>
                                </Grid>
                            </Border>
                        </Border>
                        <Rectangle x:Name="PART_DisabledVisual" Fill="{StaticResource DisabledColor}" Opacity="0" RadiusY="2" RadiusX="2" Stretch="Fill"
                                   Stroke="{StaticResource DisabledColor}" StrokeThickness="1" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Visibility" TargetName="PART_DisabledVisual" Value="Visible"/>
                        </Trigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Year">
                            <Setter Property="Visibility" TargetName="PART_MonthView" Value="Hidden"/>
                            <Setter Property="Visibility" TargetName="PART_YearView" Value="Visible"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding DisplayMode, RelativeSource={RelativeSource FindAncestor, AncestorType={x:Type Calendar}}}" Value="Decade">
                            <Setter Property="Visibility" TargetName="PART_MonthView" Value="Hidden"/>
                            <Setter Property="Visibility" TargetName="PART_YearView" Value="Visible"/>
                        </DataTrigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    
    <!-- Стиль кнопок (чисел) календаря (общий) -->
    <Style TargetType="{x:Type CalendarDayButton}" BasedOn="{StaticResource BaseStyle}" x:Key="BaseCalendarDayButton">
        <Setter Property="MinWidth" Value="5"/>
        <Setter Property="MinHeight" Value="5"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarDayButton}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0.5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Disabled">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="0" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="HighlightBackground"/>
                                        <DoubleAnimation Duration="0" To=".35" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="NormalText"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unselected"/>
                                <!-- Выбранная дата -->
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".9" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedBackground"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="DayButtonFocusVisual">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Active"/>
                                <!-- Даты не выбранного месяца -->
                                <VisualState x:Name="Inactive">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#FFA1A1A1"
                                                        Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                        Storyboard.TargetName="NormalText"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="DayStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="RegularDay"/>
                                <VisualState x:Name="Today">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To="1" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="TodayBackground"/>
                                        <ColorAnimation Duration="0" To="#FFFFFFFF"
                                                        Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)"
                                                        Storyboard.TargetName="NormalText"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="BlackoutDayStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="NormalDay"/>
                                <VisualState x:Name="BlackoutDay">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".2" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Blackout"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="TodayBackground" Fill="{DynamicResource TodayCalendarDateBackground}" Opacity="0" RadiusY="1" RadiusX="1"/>
                        <Rectangle x:Name="SelectedBackground" Fill="{DynamicResource ButtonIsPressedBackground}" Opacity="0" RadiusY="1" RadiusX="1"/>
                        <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" Background="{TemplateBinding Background}"/>
                        <Rectangle x:Name="HighlightBackground" Fill="{DynamicResource TaskItemIsSelectedBackground}" Opacity="0" RadiusY="1" RadiusX="1"/>
                        <!-- Текущий месяц -->
                        <ContentPresenter x:Name="NormalText"
                                          TextElement.Foreground="{DynamicResource TextForeground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          Margin="5,1,5,1" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
                        <Path x:Name="Blackout"
                              Data="M8.1772461,11.029181 L10.433105,11.029181 L11.700684,12.801641 L12.973633,11.029181 L15.191895,11.029181 L12.844727,13.999395 L15.21875,17.060919 L12.962891,17.060919 L11.673828,15.256231 L10.352539,17.060919 L8.1396484,17.060919 L10.519043,14.042364 z"
                              Fill="#FF000000" HorizontalAlignment="Stretch" Margin="3" Opacity="0" RenderTransformOrigin="0.5,0.5" Stretch="Fill" VerticalAlignment="Stretch"/>
                        <Rectangle x:Name="DayButtonFocusVisual" IsHitTestVisible="false" RadiusY="1" RadiusX="1" Stroke="#FF45D6FA" Visibility="Collapsed"/>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль кнопок (месяцев и лет) календаря (общий) -->
    <Style TargetType="CalendarButton" BasedOn="{StaticResource BaseStyle}" x:Key="BaseCalendarButton">
        <Setter Property="Background" Value="#FFBADDE9"/>
        <Setter Property="MinWidth" Value="50"/>
        <Setter Property="MinHeight" Value="54"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type CalendarButton}">
                    <Grid>
                        <VisualStateManager.VisualStateGroups>
                            <VisualStateGroup x:Name="CommonStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0:0:0.1"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Normal"/>
                                <VisualState x:Name="MouseOver">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Background"/>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="Pressed">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".5" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="Background"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="SelectionStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Unselected"/>
                                <!-- Выбранный месяц/год -->
                                <VisualState x:Name="Selected">
                                    <Storyboard>
                                        <DoubleAnimation Duration="0" To=".9" Storyboard.TargetProperty="Opacity" Storyboard.TargetName="SelectedBackground"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="ActiveStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="Active"/>
                                <VisualState x:Name="Inactive">
                                    <Storyboard>
                                        <ColorAnimation Duration="0" To="#FFA1A1A1"
                                                        Storyboard.TargetProperty="(TextElement.Foreground).(SolidColorBrush.Color)" Storyboard.TargetName="NormalText"/>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                            <VisualStateGroup x:Name="CalendarButtonFocusStates">
                                <VisualStateGroup.Transitions>
                                    <VisualTransition GeneratedDuration="0"/>
                                </VisualStateGroup.Transitions>
                                <VisualState x:Name="CalendarButtonFocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="CalendarButtonFocusVisual">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Visible</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                                <VisualState x:Name="CalendarButtonUnfocused">
                                    <Storyboard>
                                        <ObjectAnimationUsingKeyFrames Duration="0" Storyboard.TargetProperty="Visibility" Storyboard.TargetName="CalendarButtonFocusVisual">
                                            <DiscreteObjectKeyFrame KeyTime="0">
                                                <DiscreteObjectKeyFrame.Value>
                                                    <Visibility>Collapsed</Visibility>
                                                </DiscreteObjectKeyFrame.Value>
                                            </DiscreteObjectKeyFrame>
                                        </ObjectAnimationUsingKeyFrames>
                                    </Storyboard>
                                </VisualState>
                            </VisualStateGroup>
                        </VisualStateManager.VisualStateGroups>
                        <Rectangle x:Name="SelectedBackground" Fill="{DynamicResource ButtonIsPressedBackground}" Opacity="0" RadiusY="1" RadiusX="1"/>
                        <Rectangle x:Name="Background" Fill="{DynamicResource TaskItemIsSelectedBackground}" Opacity="0" RadiusY="1" RadiusX="1"/>
                        <ContentPresenter x:Name="NormalText"
                                          TextElement.Foreground="{DynamicResource TextForeground}"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="1,0,1,1">
                        </ContentPresenter>
                        <Rectangle x:Name="CalendarButtonFocusVisual" IsHitTestVisible="false" RadiusY="1" RadiusX="1" Stroke="#FF45D6FA" Visibility="Collapsed"/>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsFocused" Value="True">
                            <Setter Property="Visibility" TargetName="CalendarButtonFocusVisual" Value="Visible"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль календаря (общий) -->
    <Style TargetType="Calendar" x:Key="BaseCalendarStyle">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"/>
        <Setter Property="CalendarButtonStyle" Value="{StaticResource BaseCalendarButton}"></Setter>
        <Setter Property="CalendarDayButtonStyle" Value="{StaticResource BaseCalendarDayButton}"></Setter>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Calendar">
                    <StackPanel x:Name="PART_Root" HorizontalAlignment="Center">
                        <CalendarItem x:Name="PART_CalendarItem"
                                      Background="{TemplateBinding Background}"
                                      BorderBrush="{TemplateBinding BorderBrush}"
                                      BorderThickness="{TemplateBinding BorderThickness}"
                                      Style="{StaticResource BaseCalendarItem}"/>
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки в свойствах задачи 
    Используем разделение, чтобы для каждого раздела создавался свой экземпляр -->
    <col:ArrayList x:Shared="False" x:Key="TaskTabHeaders">
        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource BaseStyleAlignment}">Info</TextBlock>
            </TabItem.Header>
            <v:TaskObjectView DataContext="{Binding Path=SelectedTaskViewModel}"></v:TaskObjectView>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource BaseStyleAlignment}" ToolTip="В текущей версии приложения данный функционал не реализован">Файлы</TextBlock>
            </TabItem.Header>
        </TabItem>
    </col:ArrayList>
    
</ResourceDictionary>