<ResourceDictionary x:Class="TaskManager.Resources.ControlStyles"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TaskManager.Views"
                    xmlns:local="clr-namespace:TaskManager.Resources"
                    xmlns:model="clr-namespace:TaskManager.Model"
                    xmlns:ctrl="clr-namespace:TaskManager.CustomControls"
                    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib">

    <!-- Стиль для всех заголовков вкладок -->
    <Style TargetType="TabItem">
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"></Setter>
        <Setter Property="BorderThickness" Value="1.5, 1.5, 1.5, 0"></Setter>
        <Setter Property="Template" Value="{StaticResource TabItemTemplate}"></Setter>
    </Style>

    <!-- Стиль для "статических" кнопок меню в боковой панели -->
    <Style TargetType="Button" x:Key="MenuButtonIcon">
        <Setter Property="Template" Value="{StaticResource MenuButtonTemplate}"/>
        <Setter Property="BorderBrush" Value="{DynamicResource AntiMainColor}"></Setter>
        <Setter Property="Background" Value="{x:Null}"></Setter>
        <Setter Property="BorderThickness" Value="2"></Setter>
        <Setter Property="Margin" Value="2"></Setter>
    </Style>

    <!-- Стиль для кнопок выдвигающегся меню -->
    <!--TODO: Сделать конвертер для задания пропорциональной высоты кнопки относительно панели-->
    <Style TargetType="ContentControl" x:Key="MenuButton">
        <Setter Property="MinHeight" Value="50"></Setter>
        <Setter Property="Width" Value="{Binding ElementName=menu,Path=Width}"></Setter>
        <Setter Property="Background" Value="{Binding ElementName=menu,Path=Background}"></Setter>
        <Setter Property="BorderBrush" Value="{x:Null}"></Setter>
        <Setter Property="FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=MenuCommandsFont}"></Setter>
        <Setter Property="Foreground" Value="{DynamicResource TextForeground}"></Setter>
        <Setter Property="FontFamily" Value="Monotype Corsiva"></Setter>
    </Style>

    <!-- Стиль элемента списка (основной раздел) -->
    <Style TargetType="ListBoxItem" x:Key="MasterTaskItem">
        <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}"></Setter>
        <Setter Property="BorderThickness" Value="1.5"></Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <!-- У меню DataContext - это TaskObjectViewModel (элемент списка) -->
                <ContextMenu>
                    <MenuItem Style="{StaticResource ChangeSectionCommandMenuItem}" IsEnabled="{Binding ChangeSectionEnabled}"></MenuItem>
                    <MenuItem Style="{StaticResource AcceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource RejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DeferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DoneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource CompleteCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль элемента дерева (неосновной раздел) -->
    <Style TargetType="ctrl:StretchingTreeViewItem" x:Key="AdditionalTaskItem">
        <Setter Property="Template" Value="{StaticResource TreeViewItemTemplate}"></Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource ChangeSectionCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource AcceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource RejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DeferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource DoneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource CompleteCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource MakeRootCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        <Setter Property="AllowDrop" Value="True"></Setter>

        <!-- Drag&Drop -->
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="PreviewMouseRightButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewMouseLeftButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseMove" Handler="PreviewMouseMoveItem"></EventSetter>
        <EventSetter Event="Drop" Handler="DropItem"></EventSetter>
    </Style>

    <!-- Стиль, отвечающий за отображение "пустой" задачи -->
    <Style TargetType="Image" x:Shared="False" x:Key="EmptyTaskImageStyle">
        <Setter Property="Visibility" Value="{Binding Path=VisibilityEmptyTaskImage}"></Setter>
        <Setter Property="Source" Value="/Resources/Images/QuestionPromo.png"></Setter>
        <Setter Property="Stretch" Value="Fill"></Setter>
    </Style>

    <!-- Стиль элемента комбобокса (в выпадающем списке) -->
    <Style TargetType="ComboBoxItem" x:Key="ComboBoxItem">
        <Setter Property="Template" Value="{StaticResource ListBoxItemTemplate}"></Setter>
    </Style>

    <!-- Стиль комбобокса (общий) -->
    <Style TargetType="ComboBox" x:Key="BaseComboBox">
        <Setter Property="Template" Value="{StaticResource ComboBoxTemplate}"></Setter>
        <Setter Property="ItemContainerStyle" Value="{StaticResource ComboBoxItem}"></Setter>
    </Style>

    <!-- Стиль чекбокса (общий) -->
    <Style TargetType="ctrl:CheckBoxWithItemStyle" BasedOn="{StaticResource BaseStyleAlignmentMargin}" x:Key="BaseCheckBox">
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="TextBlockStyle" Value="{StaticResource BaseStyleAlignmentMargin}"></Setter>
        <Setter Property="Template" Value="{StaticResource CheckBoxTemplate}"></Setter>
    </Style>

    <!-- Стиль чекбокса, у которого галочка справа -->
    <!-- Ставим галочку справа и переворачиваем направление внутри самого чекбокса (иначе галочка будет отзеркалена) -->
    <Style TargetType="ctrl:CheckBoxWithItemStyle" BasedOn="{StaticResource BaseCheckBox}" x:Key="FlowDirectionCheckBox">
        <Setter Property="FlowDirection" Value="RightToLeft" />
        <Style.Resources>
            <Style TargetType="Path">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
        </Style.Resources>
    </Style>
    
    <!-- Стиль радиокнопки (общий) -->
    <!-- Тут не получится так же, как с чекбоксом, т.к. здесь нет объекта Path -->
    <Style TargetType="RadioButton" BasedOn="{StaticResource BaseScale}" x:Key="BaseRadioButton">
        <Setter Property="TextBlock.FontSize" Value="{x:Static local:Constants.StandartBaseFont}"></Setter>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextForeground}"></Setter>
    </Style>
    
    <!-- Стиль текстбокса (общий) -->
    <Style TargetType="TextBox" BasedOn="{StaticResource BaseStyle}" x:Key="BaseTextBox">
        <Setter Property="Template" Value="{StaticResource TextBoxTemplate}"></Setter>
        <Setter Property="Background" Value="{DynamicResource FieldBackground}"></Setter>
        <Style.Triggers>
            <Trigger Property="IsReadOnly" Value="True">
                <Setter Property="Background" Value="{DynamicResource FieldBackgroundReadOnly}"></Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBox}" x:Key="BaseTextBoxAlignment">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxAlignment}" x:Key="BaseTextBoxAlignmentMargin">
        <Setter Property="Margin" Value="3,0,3,0"></Setter>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource BaseTextBoxAlignmentMargin}" x:Key="FullReadOnlyLine">
        <Setter Property="IsReadOnly" Value="True"></Setter>
        <Setter Property="Focusable" Value="False"></Setter>
        <Setter Property="Cursor" Value="Arrow"></Setter>
    </Style>

    <!-- Стиль для служебных кнопок приложения (ОК, Отмена и т.п.) -->
    <Style TargetType="Button" BasedOn="{StaticResource BaseStyle}" x:Key="ServiceButton">
        <Setter Property="Template" Value="{StaticResource ServiceButtonTemplate}"/>
        <Setter Property="Background" Value="{DynamicResource ButtonBackground}"></Setter>
        <Setter Property="Margin" Value="3,2,3,2"></Setter>
        <Setter Property="MinWidth" Value="100"></Setter>
        <Setter Property="MaxWidth" Value="200"></Setter>
    </Style>

    <!-- Вкладки в свойствах задачи 
    Используем разделение, чтобы для каждого раздела создавался свой экземпляр -->
    <col:ArrayList x:Shared="False" x:Key="TaskTabHeaders">
        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource BaseStyleAlignment}">Info</TextBlock>
            </TabItem.Header>
            <v:TaskObjectView DataContext="{Binding Path=SelectedTaskViewModel}"></v:TaskObjectView>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource BaseStyleAlignment}">Файлы</TextBlock>
            </TabItem.Header>
        </TabItem>
    </col:ArrayList>
    
</ResourceDictionary>