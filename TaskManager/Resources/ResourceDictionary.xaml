<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Style TargetType="Button" x:Key="menuButtonIcon">
        <Setter Property="BorderBrush" Value="Black"></Setter>
        <Setter Property="Background" Value="White"></Setter>
    </Style>

    <Style TargetType="Image" x:Key="menuImageIcon">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <!--TODO: Сделать конвертер для задания пропорциональной высоты кнопки относительно панели-->
    <Style TargetType="Button" x:Key="menuButton">
        <Setter Property="MinHeight" Value="50"></Setter>
        <Setter Property="Width" Value="{Binding ElementName=menu,Path=Width}"></Setter>
        <Setter Property="Background" Value="{Binding ElementName=menu,Path=Background}"></Setter>
        <Setter Property="BorderBrush" Value="{x:Null}"></Setter>
        <Setter Property="FontSize" Value="20"></Setter>
        <Setter Property="FontFamily" Value="Monotype Corsiva"></Setter>
    </Style>

    <!-- Порядок расположения важен: если определить шаблон после стиля, в котором он используется, то стиль его не увидит -->
    <ControlTemplate TargetType="Button" x:Key="serviceButtonTemplate">
        <Border x:Name="serviceButtonBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Height="{TemplateBinding Height}"
                Width="{TemplateBinding Width}" >
            <ContentControl HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding Content}">
            </ContentControl>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="serviceButtonBorder" Property="Background" Value="Azure" />
                <Setter TargetName="serviceButtonBorder" Property="BorderBrush" Value="DarkBlue" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>
    
    <Style TargetType="Button" x:Key="serviceButtonBase">
        <Setter Property="Template" Value="{StaticResource serviceButtonTemplate}"/>
        <Setter Property="Margin" Value="3,2,3,2"></Setter>
    </Style>

    <Style TargetType="Button" BasedOn="{StaticResource serviceButtonBase}" x:Key="serviceButtonWithStandartWidth">
        <Setter Property="Width" Value="100"></Setter>
    </Style>

    <Style TargetType="TextBlock" x:Key="fieldDescription">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
        <Setter Property="Margin" Value="5,0,5,0"></Setter>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource fieldDescription}" x:Key="titleDescription">
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="14"></Setter>
        <Setter Property="Margin" Value="10,0,0,0"></Setter> <!-- Переопределяем -->
    </Style>

    <Style TargetType="{x:Type MenuItem}" x:Key="collapsedMenuItem">
        <Setter Property="Visibility" Value="Collapsed"></Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="acceptCommandMenuItem">
        <Style.Triggers>
            <!-- PlacementTarget указывает на тот элемент, с которого было вызвано меню. В данном случае - это TaskObjectViewModel (элемент списка) -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                        Path=PlacementTarget.DataContext.AcceptCommandVisibility}"
                     Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="rejectCommandMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                    Path=PlacementTarget.DataContext.RejectCommandVisibility}"
                 Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="deferCommandMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                    Path=PlacementTarget.DataContext.DeferCommandVisibility}"
                 Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="doneCommandMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.DoneCommandVisibility}"
             Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="completeCommandMenuItem">
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.CompleteCommandVisibility}"
             Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

</ResourceDictionary>