<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Шаблон элемента контекстного меню (общий) -->
    <ControlTemplate TargetType="MenuItem" x:Key="ContextMenuItemTemplate">
        <Border x:Name="itemBorder"
            Padding="27,0,17,0"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            SnapsToDevicePixels="True">
            <ContentPresenter Content="{TemplateBinding Header}"
                          ContentSource="Header"
                          Margin="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="Gray"></Setter>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource MenuItemIsMouseOverBackground}"/>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource MenuItemIsMouseOverBorder}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон контекстного меню (общий) -->
    <ControlTemplate TargetType="ContextMenu" x:Key="ContextMenuTemplate">
        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{StaticResource DefaultBorder}">
            <StackPanel ClipToBounds="True" Orientation="Vertical" IsItemsHost="True" Margin="5,4,5,4" />
        </Border>
    </ControlTemplate>

</ResourceDictionary>