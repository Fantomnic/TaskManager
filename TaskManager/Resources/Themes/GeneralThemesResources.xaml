<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Элементы списка/дерева -->
    <SolidColorBrush Color="#4C75BEFF" x:Key="TaskItemIsMouseOverBackground" />
    <SolidColorBrush Color="#CC50ADFF" x:Key="TaskItemIsMouseOverBorder" />
    <SolidColorBrush Color="#6675BEFF" x:Key="TaskItemIsSelectedBackground" />
    <SolidColorBrush Color="#FF319AF7" x:Key="TaskItemIsSelectedBorder" />

    <!-- Текстовые поля -->
    <SolidColorBrush Color="#FF2599FF" x:Key="FieldIsMouseOverBorder" />
    <SolidColorBrush Color="Blue" x:Key="FieldIsFocusedBorder" />

    <!-- Значения ЭУ по умолчанию -->
    <SolidColorBrush Color="#FFABADB3" x:Key="DefaultBorder" />
    
</ResourceDictionary>