<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Элементы списка/дерева -->
    <SolidColorBrush Color="#4775BEFF" x:Key="TaskItemIsMouseOverBackground" />
    <SolidColorBrush Color="#CC50ADFF" x:Key="TaskItemIsMouseOverBorder" />
    <SolidColorBrush Color="#5B75BEFF" x:Key="TaskItemIsSelectedBackground" />

    <!-- Текстовые поля -->
    <SolidColorBrush Color="#FF2599FF" x:Key="FieldIsMouseOverBorder" />
    <SolidColorBrush Color="Blue" x:Key="FieldIsFocusedBorder" />

    <!-- Контекстное меню -->
    <SolidColorBrush Color="#3F3FC2EE" x:Key="MenuItemIsMouseOverBackground" />
    <SolidColorBrush Color="#CC5E97FF" x:Key="MenuItemIsMouseOverBorder" />
    
    <!-- Значения ЭУ по умолчанию -->
    <SolidColorBrush Color="#FFABADB3" x:Key="DefaultBorder" />

    <SolidColorBrush Color="#FFA1A1A1" x:Key="Test"></SolidColorBrush>
</ResourceDictionary>