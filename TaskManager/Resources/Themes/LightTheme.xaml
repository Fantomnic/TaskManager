<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <SolidColorBrush Color="Black" x:Key="textForeground" />
    <SolidColorBrush Color="Red" x:Key="titleForeground" />
    <SolidColorBrush Color="White" x:Key="windowBackgroung" />
    <SolidColorBrush Color="Yellow" x:Key="fieldBackgroung" />

    <!-- Цвета статусов -->
    <SolidColorBrush Color="#D9D9D9" x:Key="waitingStatusBackground" />
    <SolidColorBrush Color="#92D050" x:Key="beginningStatusBackground" />
    <SolidColorBrush Color="Yellow" x:Key="deferredStatusBackground" />
    <SolidColorBrush Color="Red" x:Key="rejectedStatusBackground" />
    <SolidColorBrush Color="#00CCFF" x:Key="doneStatusBackground" />
    <SolidColorBrush Color="#9954CC" x:Key="completedStatusBackground" />
    
    
</ResourceDictionary>