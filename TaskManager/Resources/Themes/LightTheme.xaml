<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Иконки меню -->
    <Style TargetType="Image" BasedOn="{StaticResource MenuImageIcon}" x:Key="NewTaskIcon">
        <Setter Property="Source" Value="/Resources/Images/LightPlus.png"></Setter>
    </Style>

    <Style TargetType="Image" BasedOn="{StaticResource MenuImageIcon}" x:Key="MenuActionsIcon">
        <Setter Property="Source" Value="/Resources/Images/LightMenuIcon.png"></Setter>
    </Style>

    <Style TargetType="Image" BasedOn="{StaticResource MenuImageIcon}" x:Key="SettingsIcon">
        <Setter Property="Source" Value="/Resources/Images/LightSettingsIcon.png"></Setter>
    </Style>

    <Style TargetType="Image" BasedOn="{StaticResource MenuImageIcon}" x:Key="AppInfoIcon">
        <Setter Property="Source" Value="/Resources/Images/LightAppInfo.png"></Setter>
    </Style>

    <!-- Цветовые настройки шрифта/фона -->
    <SolidColorBrush Color="Black" x:Key="AntiMainColor" />
    <SolidColorBrush Color="Black" x:Key="WindowTitleForeground" />
    
    <SolidColorBrush Color="Black" x:Key="TextForeground" />
    <SolidColorBrush Color="#FFE60000" x:Key="TitleForeground" />
    <SolidColorBrush Color="White" x:Key="WindowBackground" />
    <SolidColorBrush Color="#FFEBF3F3" x:Key="InnerBackground" />
    <SolidColorBrush Color="White" x:Key="FieldBackground" />
    <SolidColorBrush Color="Gainsboro" x:Key="FieldBackgroundReadOnly" />

    <!-- Кнопки (в т.ч. вкладки) -->
    <SolidColorBrush Color="WhiteSmoke" x:Key="ButtonBackground" />
    <SolidColorBrush Color="Azure" x:Key="ButtonIsMouseOverBackground" />
    <SolidColorBrush Color="Blue" x:Key="ButtonIsMouseOverBorder" />
    <SolidColorBrush Color="#FFAFF9F9" x:Key="ButtonIsPressedBackground" />
    <SolidColorBrush Color="#66FFFFFF" x:Key="MenuButtonIsMouseOverBackground" />
    <SolidColorBrush Color="#660000FF" x:Key="MenuButtonIsMouseOverBorder" />
    
    <!-- Границы бордеров -->
    <SolidColorBrush Color="#FF2210E3" x:Key="TaskDescriptionBorder" />
    <SolidColorBrush Color="Orange" x:Key="FieldIsMouseOverBorderReadOnly" />
    <SolidColorBrush Color="Red" x:Key="FieldIsFocusedBorderReadOnly" />
    <SolidColorBrush Color="Black" x:Key="BlackGrayBorder" />
    <SolidColorBrush Color="Black" x:Key="BlackBlueBorder" />
    <SolidColorBrush Color="#FF3168F7" x:Key="TaskItemIsSelectedBorder" />

    <!-- Скорллбар -->
    <SolidColorBrush Color="White" x:Key="ScrollBarBackground" />
    <SolidColorBrush Color="#FFEBF3F3" x:Key="ScrollBarElementsBackground" />
    
    <!-- Цвета статусов -->
    <SolidColorBrush Color="#FFDFDFDF" x:Key="WaitingStatusBackground" />
    <SolidColorBrush Color="#92D050" x:Key="BeginningStatusBackground" />
    <SolidColorBrush Color="Yellow" x:Key="DeferredStatusBackground" />
    <SolidColorBrush Color="#FFFF4747" x:Key="RejectedStatusBackground" />
    <SolidColorBrush Color="#00CCFF" x:Key="DoneStatusBackground" />
    <SolidColorBrush Color="#9954CC" x:Key="CompletedStatusBackground" />

    <!-- Цвета приоритетов -->
    <SolidColorBrush Color="#FF00CF00" x:Key="LowPriorityForeground" />
    <SolidColorBrush Color="#FF889815" x:Key="PostLowPriorityForeground" />
    <SolidColorBrush Color="#FFEEBE25" x:Key="MiddlePriorityForeground" />
    <SolidColorBrush Color="#FFFF8202" x:Key="PreHighPriorityForeground" />
    <SolidColorBrush Color="Red" x:Key="HighPriorityForeground" />
    
    <LinearGradientBrush StartPoint="1,0.5" EndPoint="0,0.5" x:Key="MenuGradientBackground">
        <GradientStop Color="#FF0C7BFF" Offset="0" />
        <GradientStop Color="#FF00EDFF" Offset="1" />
    </LinearGradientBrush>

    <SolidColorBrush Color="#FFE3E300" x:Key="TodayCalendarDateBackground"></SolidColorBrush>
    
</ResourceDictionary>