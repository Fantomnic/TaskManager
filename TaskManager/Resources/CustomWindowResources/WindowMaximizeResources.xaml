<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Вариант для максимального окна -->
    <PathGeometry x:Key="MiddleWindowButtonPathData">
        <PathFigure IsClosed="True" StartPoint="0,2">
            <LineSegment Point="0,10" />
            <LineSegment Point="8,10" />
            <LineSegment Point="8,2" />
        </PathFigure>
        <PathFigure StartPoint="2,2">
            <LineSegment Point="2,0" />
            <LineSegment Point="10,0" />
            <LineSegment Point="10,8" />
            <LineSegment Point="8,8" />
        </PathFigure>
    </PathGeometry>

    <Thickness Left="5" Top="0" Right="7" Bottom="5" x:Key="WindowThickness"></Thickness>
    
</ResourceDictionary>