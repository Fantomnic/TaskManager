<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:TaskManager.Model"
                    xmlns:sys="clr-namespace:System;assembly=mscorlib">

    <!-- Для всех подсказок -->
    <Style TargetType="ToolTip">
        <Setter Property="FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFont}"></Setter>
    </Style>

    <!-- Пояснения: https://translated.turbopages.org/proxy_u/en-ru.ru.f98dd4d1-69c302e2-86bb2ad1-74722d776562/https/stackoverflow.com/questions/29697807/why-doesnt-my-textblock-style-inherit-from-my-base-style -->
    <Style TargetType="FrameworkElement" x:Key="baseStyle">
        <Setter Property="TextBlock.FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFont}"></Setter>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource textForeground}"></Setter>
    </Style>

    <Style TargetType="FrameworkElement" BasedOn="{StaticResource baseStyle}" x:Key="baseStyleAlignment">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style TargetType="FrameworkElement" BasedOn="{StaticResource baseStyleAlignment}" x:Key="baseStyleAlignmentMargin">
        <Setter Property="Margin" Value="3,0,3,0"></Setter>
    </Style>

    <!-- Стиль для галочки в чекбоксе или точки в радиокнопке -->
    <Style TargetType="Path" x:Key="pathScale">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFontCoefficient}"
                    ScaleY="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFontCoefficient}" />
            </Setter.Value>
        </Setter>
        <Setter Property="VerticalAlignment" Value="Bottom"></Setter>
    </Style>

    <Style TargetType="RadioButton" BasedOn="{StaticResource baseStyleAlignmentMargin}" x:Key="baseStyleRadioButton">
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource pathScale}"></Style>
        </Style.Resources>
        <Setter Property="RenderTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="1.16" ScaleY="1.16"/>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="CheckBox" BasedOn="{StaticResource baseStyleAlignmentMargin}" x:Key="baseStyleCheckBox">
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource pathScale}"></Style>
        </Style.Resources>
    </Style>
    
    <!-- Ставим галочку справа и переворачиваем направление внутри самого чекбокса (иначе галочка будет отзеркалена) -->
    <Style TargetType="CheckBox" BasedOn="{StaticResource baseStyleCheckBox}" x:Key="flowDirectionCheckBox">
        <Style.Resources>
            <Style TargetType="Path" BasedOn="{StaticResource pathScale}">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
            <Style TargetType="TextBlock">
                <Setter Property="FlowDirection" Value="LeftToRight" />
            </Style>
        </Style.Resources>

        <Setter Property="FlowDirection" Value="RightToLeft" />
    </Style>

    <VisualBrush x:Key="CueBannerBrush" AlignmentX="Left" AlignmentY="Center" Stretch="None">
        <VisualBrush.Visual>
            <Label Content="Нет" Style="{StaticResource baseStyle}" Foreground="LightGray" />
        </VisualBrush.Visual>
    </VisualBrush>

    <Style TargetType="TextBox" BasedOn="{StaticResource baseStyleAlignmentMargin}" x:Key="lineTextBoxWithHint">
        <Style.Triggers>
            <Trigger Property="Text" Value="{x:Static sys:String.Empty}">
                <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
            </Trigger>
            <Trigger Property="Text" Value="{x:Null}">
                <Setter Property="Background" Value="{StaticResource CueBannerBrush}" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="TextBox" BasedOn="{StaticResource baseStyleAlignmentMargin}" x:Key="fullReadOnlyLine">
        <Setter Property="IsReadOnly" Value="True"></Setter>
        <Setter Property="Focusable" Value="False"></Setter>
        <Setter Property="Cursor" Value="Arrow"></Setter>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource baseStyleAlignment}" x:Key="fieldDescription">
        <Setter Property="Margin" Value="5,0,5,0"></Setter>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource fieldDescription}" x:Key="titleDescription">
        <Setter Property="Foreground" Value="{DynamicResource titleForeground}"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=TitleFont}"></Setter>
        <Setter Property="Margin" Value="10,0,0,0"></Setter> <!-- Переопределяем -->
    </Style>

</ResourceDictionary>