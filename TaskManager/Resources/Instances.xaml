<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:h="clr-namespace:TaskManager.Helpers"
                    xmlns:cmd="clr-namespace:TaskManager.Commands">

    <!-- Конвертеры -->
    <h:TaskTypeConverter x:Key="TaskTypeConverter" />
    <h:ThemeConverter x:Key="ThemeConverter" />
    <h:FontIDConverter x:Key="FontIDConverter" />
    <h:DateConverter x:Key="DateConverter" />
    <h:IntegerConverter x:Key="IntegerConverter" />
    
    <!-- Команды -->
    <!-- Прим.: Таким способом нельзя создать экземпляр вложенного класса.
    Более того, название класса должно совпадать с названием файла, в котором он определён.
    Плюс такой реализации: меньше кода в xaml-файлах + все экземпляры приложения в одном месте -->
    <!-- Прим.: Если делать через создание статических экземпляров в отдельном классе:
    Можно делать команды internal, помещать их экземпляры в DataContext и через привязку использовать в соответствующем представлении.
    Но чтобы можно было задавать их в xaml, нужен public -->
    <!-- TODO: Возможно, реализация через свойства будет лучше, т.к. не придётся следить за корректностью ключей (в 2 местах - тут и в словаре) -->
    <cmd:ChangeSectionCommand x:Key="ChangeSectionCommand" />
    <cmd:AcceptTaskCommand x:Key="AcceptTaskCommand" />
    <cmd:RejectTaskCommand x:Key="RejectTaskCommand" />
    <cmd:DeferTaskCommand x:Key="DeferTaskCommand" />
    <cmd:DoneTaskCommand x:Key="DoneTaskCommand" />
    <cmd:CompleteTaskCommand x:Key="CompleteTaskCommand" />
    <cmd:DeleteSectionCommand x:Key="DeleteSectionCommand" />
    <cmd:ShowTaskPropertyCommand x:Key="ShowTaskPropertyCommand" />
    <cmd:DeleteTaskCommand x:Key="DeleteTaskCommand" />
    <cmd:NewSectionCommand x:Key="NewSectionCommand" />
    <cmd:NewTaskCommand x:Key="NewTaskCommand" />
    <cmd:OpenSettingsCommand x:Key="OpenSettingsCommand" />
    <cmd:ShowSectionPropertyCommand x:Key="ShowSectionPropertyCommand" />
    <cmd:MakeRootCommand x:Key="MakeRootCommand" />
    <cmd:ExportCommand x:Key="ExportCommand" />
    <cmd:ImportCommand x:Key="ImportCommand" />
    
    <cmd:TestCommand x:Key="TestCommand" />

</ResourceDictionary>