<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:model="clr-namespace:TaskManager.Model">

    <!-- Здесь размещаются самостоятельные ресурсы, которые не ссылаются (статически) на другие словари -->

    <Style TargetType="Button" x:Key="WindowButtonBase">
        <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True"></Setter>
        <Setter Property="HorizontalAlignment" Value="Right"></Setter>
        <Setter Property="FontSize" Value="10"></Setter>
        <Setter Property="Foreground" Value="#999999"></Setter>
        <Setter Property="Background" Value="Transparent"></Setter>
    </Style>

    <!-- Пояснения:
    https://translated.turbopages.org/proxy_u/en-ru.ru.f98dd4d1-69c302e2-86bb2ad1-74722d776562/https/stackoverflow.com/questions/29697807/why-doesnt-my-textblock-style-inherit-from-my-base-style -->
    <Style TargetType="FrameworkElement" x:Key="BaseStyle">
        <Setter Property="TextBlock.FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFont}"></Setter>
        <Setter Property="TextBlock.Foreground" Value="{DynamicResource TextForeground}"></Setter>
    </Style>

    <Style TargetType="FrameworkElement" BasedOn="{StaticResource BaseStyle}" x:Key="BaseStyleAlignment">
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <Style TargetType="FrameworkElement" BasedOn="{StaticResource BaseStyleAlignment}" x:Key="BaseStyleAlignmentMargin">
        <Setter Property="Margin" Value="3,0,3,0"></Setter>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseStyleAlignment}" x:Key="FieldDescription">
        <Setter Property="Margin" Value="5,0,5,0"></Setter>
    </Style>

    <Style TargetType="TextBlock" BasedOn="{StaticResource FieldDescription}" x:Key="TitleDescription">
        <Setter Property="Foreground" Value="{DynamicResource TitleForeground}"></Setter>
        <Setter Property="FontWeight" Value="Bold"></Setter>
        <Setter Property="FontSize" Value="{Binding Source={x:Static model:Settings.FontSettings},Path=TitleFont}"></Setter>
        <!-- Переопределяем -->
        <Setter Property="Margin" Value="10,0,0,0"></Setter>
    </Style>

    <!-- Масштабирование в зависимости от размера шрифта -->
    <Style TargetType="FrameworkElement" x:Key="BaseScale">
        <Setter Property="LayoutTransform">
            <Setter.Value>
                <ScaleTransform ScaleX="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFontCoefficient}"
                            ScaleY="{Binding Source={x:Static model:Settings.FontSettings},Path=BaseFontCoefficient}" />
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Стиль для картинок "статических" кнопок меню в боковой панели -->
    <Style TargetType="Image" x:Key="MenuImageIcon">
        <Setter Property="HorizontalAlignment" Value="Center"></Setter>
        <Setter Property="VerticalAlignment" Value="Center"></Setter>
    </Style>

    <!-- Для всех подсказок -->
    <Style TargetType="ToolTip" BasedOn="{StaticResource BaseStyle}">
        <Setter Property="Background" Value="{DynamicResource WindowBackground}"></Setter>
        <Setter Property="BorderBrush" Value="Orange"></Setter>
    </Style>

    <!-- Для всех групбоксов -->
    <Style TargetType="GroupBox">
        <Setter Property="Background" Value="{DynamicResource InnerBackground}"></Setter>
    </Style>

</ResourceDictionary>