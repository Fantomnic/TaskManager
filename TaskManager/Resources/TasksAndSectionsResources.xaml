<ResourceDictionary x:Class="TaskManager.Resources.TasksAndSectionsResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cmd="clr-namespace:TaskManager.Commands"
                    xmlns:v="clr-namespace:TaskManager.Views"
                    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Instances.xaml" />
        <ResourceDictionary Source="/Resources/TextsResources.xaml" />
        <ResourceDictionary Source="/Resources/Themes/GeneralThemesResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Шаблон для элемента списка -->
    <ControlTemplate TargetType="ListBoxItem" x:Key="listBoxItemTemplate">
        <Border x:Name="listBoxItemBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Margin="{TemplateBinding Margin}"
                Height="{TemplateBinding Height}"
                Width="{TemplateBinding Width}" >
            <ContentControl HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}">
                <ContentControl.Content>
                    <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}"/>
                </ContentControl.Content>
            </ContentControl>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="listBoxItemBorder" Property="Background" Value="{StaticResource taskItemIsMouseOverBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{StaticResource taskItemIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="listBoxItemBorder" Property="Background" Value="{StaticResource taskItemIsSelectedBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{StaticResource taskItemIsSelectedBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>


    
    
    <ControlTemplate TargetType="ToggleButton" x:Key="expanderButton">
        <Grid Width="15" Height="13" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="Collapsed">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="Expanded">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Unchecked" />

                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 1: [Значок при скрытии потомков] -->
            <Path x:Name="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,1,1,1" Data="M 4 0 L 8 4 L 4 8 Z">
                <Path.Fill>
                    <SolidColorBrush Color="Red" />
                </Path.Fill>
            </Path>

            <!-- 2: [Значок при показе потомков] -->
            <Path x:Name="Expanded" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1,1,1,1" Data="M 0 4 L 8 4 L 4 8 Z" Visibility="Hidden">
                <Path.Fill>
                    <SolidColorBrush Color="Yellow" />
                </Path.Fill>
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- Стиль кнопки-экспандера -->
    <Style x:Key="ExpandCollapseToggleStyle" TargetType="ToggleButton">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template" Value="{StaticResource expanderButton}"></Setter>
    </Style>

    <ControlTemplate TargetType="v:StretchingTreeViewItem" x:Key="treeViewItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="19" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- 3: [Менеджер визуальных состояний, группа - SelectionStates] -->
            <!-- 3.1: [Состояние: Selected (выбрано) ] -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource taskItemIsSelectedBackground}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource taskItemIsSelectedBorder}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>
                    
                    <!-- Добавлено, чтобы происходил сброс -->
                    <VisualState x:Name="Unselected" />

                    <!-- Чтобы не происходило сброса при смене фокуса -->
                    <!--<VisualState x:Name="SelectedInactive" />-->
                </VisualStateGroup>

                <!-- 4: [Менеджер визуальных состояний, группа - ExpansionStates] -->
                <VisualStateGroup x:Name="ExpansionStates">
                    <!-- 4.1: [Состояние: Expanded (элемент раскрыт)] -->
                    <VisualState x:Name="Expanded">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ItemsHost">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Collapsed"></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- 5: [Кнопка-экспандер ] -->
            <ToggleButton x:Name="Expander"
                          Style="{StaticResource ExpandCollapseToggleStyle}"
                          ClickMode="Press"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- 6: [Рамка, в которой содержится заголовок родителя] -->
            <Border x:Name="Bd"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_Header" ContentSource="Header" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" />
            </Border>

            <!-- 7: [Потомки, принадлежат родителю] -->
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
        </Grid>

        <!-- 8: [Триггеры шаблона] -->
        <ControlTemplate.Triggers>
            <!-- 8.1: [Если родитель пустой, то скрывать кнопку-экспандер] -->
            <Trigger Property="HasItems" Value="false">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>

            <!-- 8.2: [Мультриггер для задания минимальной ширины] -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Width" Value="Auto" />
                </MultiTrigger.Conditions>

                <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>

            <!-- 8.3: [Мультриггер для задания минимальной высоты] -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Height" Value="Auto" />
                </MultiTrigger.Conditions>

                <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <Style x:Key="{x:Type TreeViewItem}" TargetType="{x:Type TreeViewItem}">
        <!-- 1: [Параметры по умолчанию] -->
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="HorizontalContentAlignment" Value="{Binding Path=HorizontalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="VerticalContentAlignment" Value="{Binding Path=VerticalContentAlignment, RelativeSource={RelativeSource AncestorType={x:Type ItemsControl}}}" />
        <Setter Property="Padding" Value="1,0,0,0" />
        <!--<Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource TreeViewItemFocusVisual}" />-->

        <!-- 2: [Шаблон] -->
        <Setter Property="Template" Value="{StaticResource treeViewItemTemplate}"></Setter>
    </Style>





    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource baseStyle}" x:Key="menuItemWithInstance">
        <Setter Property="CommandParameter" Value="{Binding Instance}"></Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource menuItemWithInstance}" x:Key="collapsedMenuItem">
        <Setter Property="Visibility" Value="Collapsed"></Setter>
    </Style>
    
    <!-- Команды контекстного меню для задач -->
    <Style TargetType="MenuItem" BasedOn="{StaticResource menuItemWithInstance}" x:Key="changeSectionCommandMenuItem">
        <Setter Property="Header" Value="Изменить раздел"></Setter>
        <Setter Property="Command" Value="{StaticResource changeSectionCommand}"></Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="acceptCommandMenuItem">
        <Setter Property="Header" Value="Принять"></Setter>
        <Setter Property="Command" Value="{StaticResource acceptTaskCommand}"></Setter>
        <Style.Triggers>
            <!-- PlacementTarget указывает на тот элемент, с которого было вызвано меню (элемент списка) -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.AcceptCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="rejectCommandMenuItem">
        <Setter Property="Header" Value="Отклонить"></Setter>
        <Setter Property="Command" Value="{StaticResource rejectTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.RejectCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="deferCommandMenuItem">
        <Setter Property="Header" Value="Отложить"></Setter>
        <Setter Property="Command" Value="{StaticResource deferTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.DeferCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource collapsedMenuItem}" x:Key="doneCommandMenuItem">
        <Setter Property="Header" Value="Выполнить"></Setter>
        <Setter Property="Command" Value="{StaticResource doneTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.DoneCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource collapsedMenuItem}" x:Key="completeCommandMenuItem">
        <Setter Property="Header" Value="Завершить"></Setter>
        <Setter Property="Command" Value="{StaticResource completeTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.CompleteCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="MenuItem" BasedOn="{StaticResource menuItemWithInstance}" x:Key="makeRootCommandMenuItem">
        <Setter Property="Header" Value="Переместить в корень"></Setter>
        <Setter Property="Command" Value="{StaticResource makeRootCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.ParentViewModel}"
                         Value="{x:Null}">
                <Setter Property="Visibility" Value="Collapsed"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Задача основного раздела -->
    <Style TargetType="ListBoxItem" x:Key="tasksMasterContextMenu">
        <Setter Property="Template" Value="{StaticResource listBoxItemTemplate}"></Setter>
        <Setter Property="BorderThickness" Value="1.5"></Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <!-- У меню DataContext - это TaskObjectViewModel (элемент списка) -->
                <ContextMenu>
                    <MenuItem Style="{StaticResource changeSectionCommandMenuItem}" IsEnabled="{Binding ChangeSectionEnabled}"></MenuItem>
                    <MenuItem Style="{StaticResource acceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource rejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource deferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource doneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource completeCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Ззадача неосновного раздела -->
    <Style TargetType="v:StretchingTreeViewItem" x:Key="tasksAdditionalContextMenu">
        <Setter Property="Template" Value="{StaticResource treeViewItemTemplate}"></Setter>
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource changeSectionCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource acceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource rejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource deferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource doneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource completeCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource makeRootCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        <Setter Property="AllowDrop" Value="True"></Setter>
        
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="PreviewMouseRightButtonDownItem"/>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewMouseLeftButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseMove" Handler="PreviewMouseMoveItem"></EventSetter>
        <EventSetter Event="Drop" Handler="DropItem"></EventSetter>
    </Style>

    <!-- Команды контекстного меню для заголовков -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource baseStyle}" x:Key="propertyMenuItem">
        <Setter Property="Header" Value="Свойства"></Setter>
        <Setter Property="Command" Value="{StaticResource showSectionPropertyCommand}"></Setter>
    </Style>

    <!-- Контекстное меню для заголовка основного раздела -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource baseStyleAlignment}" x:Key="masterSectionHeaderContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource propertyMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Контекстное меню для заголовков неосновных разделов -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource baseStyleAlignment}" x:Key="sectionHeaderContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Удалить раздел" Style="{StaticResource baseStyle}"></MenuItem>
                    <MenuItem Style="{StaticResource propertyMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки в свойствах задачи 
    Используем разделение, чтобы для каждого раздела создавался свой экземпляр -->
    <col:ArrayList x:Shared="False" x:Key="tasksTabHeaders">
        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource baseStyleAlignment}">Info</TextBlock>
            </TabItem.Header>
            <v:TaskObjectView DataContext="{Binding Path=SelectedTaskViewModel}"></v:TaskObjectView>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource baseStyleAlignment}">Файлы</TextBlock>
            </TabItem.Header>
        </TabItem>
    </col:ArrayList>

    <!-- Стиль, отвечающий за отображение "пустой" задачи -->
    <Style TargetType="Image" x:Shared="False" x:Key="emptyTaskImageStyle">
        <Setter Property="Visibility" Value="{Binding Path=VisibilityEmptyTaskImage}"></Setter>
        <Setter Property="Source" Value="/Resources/Images/QuestionPromo.png"></Setter>
        <Setter Property="Stretch" Value="Fill"></Setter>
    </Style>
    
</ResourceDictionary>