<ResourceDictionary x:Class="TaskManager.Resources.TasksAndSectionsResources"
                    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:cmd="clr-namespace:TaskManager.Commands"
                    xmlns:v="clr-namespace:TaskManager.Views"
                    xmlns:col="clr-namespace:System.Collections;assembly=mscorlib">

    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Instances.xaml" />
        <ResourceDictionary Source="/Resources/TextsResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource baseStyle}" x:Key="menuItemWithInstance">
        <Setter Property="CommandParameter" Value="{Binding Instance}"></Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource menuItemWithInstance}" x:Key="collapsedMenuItem">
        <Setter Property="Visibility" Value="Collapsed"></Setter>
    </Style>
    
    <!-- Команды контекстного меню для задач -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource menuItemWithInstance}" x:Key="changeSectionCommandMenuItem">
        <Setter Property="Header" Value="Изменить раздел"></Setter>
        <Setter Property="IsEnabled" Value="{Binding ChangeSectionEnabled}"></Setter>
        <Setter Property="Command" Value="{StaticResource changeSectionCommand}"></Setter>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="acceptCommandMenuItem">
        <Setter Property="Header" Value="Принять"></Setter>
        <Setter Property="Command" Value="{StaticResource acceptTaskCommand}"></Setter>
        <Style.Triggers>
            <!-- PlacementTarget указывает на тот элемент, с которого было вызвано меню. В данном случае - это TaskObjectViewModel (элемент списка) -->
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.AcceptCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="rejectCommandMenuItem">
        <Setter Property="Header" Value="Отклонить"></Setter>
        <Setter Property="Command" Value="{StaticResource rejectTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.RejectCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="deferCommandMenuItem">
        <Setter Property="Header" Value="Отложить"></Setter>
        <Setter Property="Command" Value="{StaticResource deferTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.DeferCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="doneCommandMenuItem">
        <Setter Property="Header" Value="Выполнить"></Setter>
        <Setter Property="Command" Value="{StaticResource doneTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.DoneCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource collapsedMenuItem}" x:Key="completeCommandMenuItem">
        <Setter Property="Header" Value="Завершить"></Setter>
        <Setter Property="Command" Value="{StaticResource completeTaskCommand}"></Setter>
        <Style.Triggers>
            <DataTrigger Binding="{Binding RelativeSource={RelativeSource AncestorType=ContextMenu},
                Path=PlacementTarget.DataContext.CompleteCommandVisibility}"
                         Value="True">
                <Setter Property="Visibility" Value="Visible"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Контекстное меню задач основного раздела -->
    <Style TargetType="ListBoxItem" x:Key="tasksMasterContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <!-- У меню DataContext - это TaskObjectViewModel (элемент списка) -->
                <ContextMenu>
                    <MenuItem Style="{StaticResource changeSectionCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource acceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource rejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource deferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource doneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource completeCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Контекстное меню задач неосновных разделов -->
    <Style TargetType="v:StretchingTreeViewItem" x:Key="tasksAdditionalContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource changeSectionCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource acceptCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource rejectCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource deferCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource doneCommandMenuItem}"></MenuItem>
                    <MenuItem Style="{StaticResource completeCommandMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
        <Setter Property="IsSelected" Value="{Binding IsSelected}"/>
        <Setter Property="AllowDrop" Value="True"></Setter>
        <EventSetter Event="PreviewMouseRightButtonDown" Handler="PreviewMouseRightButtonDownItem"/>
        <EventSetter Event="PreviewMouseLeftButtonDown" Handler="PreviewMouseLeftButtonDownItem"></EventSetter>
        <EventSetter Event="PreviewMouseMove" Handler="PreviewMouseMoveItem"></EventSetter>
        <EventSetter Event="Drop" Handler="DropItem"></EventSetter>
    </Style>

    <!-- Команды контекстного меню для заголовков -->
    <Style TargetType="{x:Type MenuItem}" BasedOn="{StaticResource baseStyle}" x:Key="propertyMenuItem">
        <Setter Property="Header" Value="Свойства"></Setter>
        <Setter Property="Command" Value="{StaticResource showSectionPropertyCommand}"></Setter>
    </Style>

    <!-- Контекстное меню для заголовка основного раздела -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource baseTextBlock}" x:Key="masterSectionHeaderContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Style="{StaticResource propertyMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Контекстное меню для заголовков неосновных разделов -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource baseTextBlock}" x:Key="sectionHeaderContextMenu">
        <Setter Property="ContextMenu">
            <Setter.Value>
                <ContextMenu>
                    <MenuItem Header="Удалить раздел" Style="{StaticResource baseStyle}"></MenuItem>
                    <MenuItem Style="{StaticResource propertyMenuItem}"></MenuItem>
                </ContextMenu>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Вкладки в свойствах задачи 
    Используем разделение, чтобы для каждого раздела создавался свой экземпляр -->
    <col:ArrayList x:Shared="False" x:Key="tasksTabHeaders">
        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource baseTextBlock}">Info</TextBlock>
            </TabItem.Header>
            <v:TaskObjectView DataContext="{Binding Path=SelectedTaskViewModel}"></v:TaskObjectView>
        </TabItem>

        <TabItem>
            <TabItem.Header>
                <TextBlock Style="{StaticResource baseTextBlock}">Файлы</TextBlock>
            </TabItem.Header>
        </TabItem>
    </col:ArrayList>

    <!-- Стиль, отвечающий за отображение "пустой" задачи -->
    <Style TargetType="Image" x:Shared="False" x:Key="emptyTaskImageStyle">
        <Setter Property="Visibility" Value="{Binding Path=VisibilityEmptyTaskImage}"></Setter>
        <Setter Property="Source" Value="/Resources/Images/QuestionPromo.png"></Setter>
        <Setter Property="Stretch" Value="Fill"></Setter>
    </Style>
    
</ResourceDictionary>