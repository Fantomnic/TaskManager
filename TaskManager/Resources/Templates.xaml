    <ControlTemplate x:Key="ExpanderTemplate" TargetType="{x:Type Expander}">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                SnapsToDevicePixels="true"
                VerticalAlignment="{TemplateBinding VerticalAlignment}">
            <DockPanel>
                <ToggleButton x:Name="HeaderSite" DockPanel.Dock="Top"
                              MinWidth="0"
                              MinHeight="{TemplateBinding MinHeight}"
                              ContentTemplate="{TemplateBinding HeaderTemplate}"
                              Content="{TemplateBinding Header}"
                              ContentTemplateSelector="{TemplateBinding HeaderTemplateSelector}"
                              FontStretch="{TemplateBinding FontStretch}"
                              Foreground="{TemplateBinding Foreground}"
                              FocusVisualStyle="{StaticResource ExpanderHeaderFocusVisual}"
                              FontStyle="{TemplateBinding FontStyle}"
                              FontFamily="{TemplateBinding FontFamily}"
                              FontWeight="{TemplateBinding FontWeight}"
                              FontSize="{TemplateBinding FontSize}"
                              HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                              VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                              IsChecked="{Binding IsExpanded, Mode=TwoWay, RelativeSource={RelativeSource Mode=TemplatedParent}}"
                              Padding="{TemplateBinding Padding}"
                              Style="{StaticResource ExpanderDownHeaderStyle}"
                              Background="Transparent">
                </ToggleButton>
                <ContentPresenter x:Name="ExpandSite" DockPanel.Dock="Bottom"
                                  Focusable="false"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                  Margin="{TemplateBinding Padding}"
                                  Visibility="Collapsed">
                </ContentPresenter>
            </DockPanel>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsExpanded" Value="true">
                <Setter Property="Visibility" TargetName="ExpandSite" Value="Visible"/>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Right">
                <Setter Property="DockPanel.Dock" TargetName="ExpandSite" Value="Right"/>
                <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Left"/>
                <Setter Property="Style" TargetName="HeaderSite" Value="{StaticResource ExpanderRightHeaderStyle}"/>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Up">
                <Setter Property="DockPanel.Dock" TargetName="ExpandSite" Value="Top"/>
                <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Bottom"/>
                <Setter Property="Style" TargetName="HeaderSite" Value="{StaticResource ExpanderUpHeaderStyle}"/>
            </Trigger>
            <Trigger Property="ExpandDirection" Value="Left">
                <Setter Property="DockPanel.Dock" TargetName="ExpandSite" Value="Left"/>
                <Setter Property="DockPanel.Dock" TargetName="HeaderSite" Value="Right"/>
                <Setter Property="Style" TargetName="HeaderSite" Value="{StaticResource ExpanderLeftHeaderStyle}"/>
            </Trigger>
            <Trigger Property="IsEnabled" Value="false">
                <Setter Property="Foreground" Value="{DynamicResource {x:Static SystemColors.GrayTextBrushKey}}"/>
            </Trigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsExpanded" Value="False"></Condition>
                    <Condition Property="IsMouseOver" Value="True"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="Background" Value="{DynamicResource MenuButtonIsMouseOverBackground}"></Setter>
            </MultiTrigger>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource MenuButtonIsMouseOverBorder}"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон для всех окон приложения -->
    <ControlTemplate TargetType="v:CustomWindow" x:Key="WindowTemplate">
        <Grid Background="{DynamicResource WindowBackground}">
            <Grid.RowDefinitions>
                <RowDefinition Height="30"></RowDefinition>
                <RowDefinition></RowDefinition>
            </Grid.RowDefinitions>
            
            <!-- Верхняя панель -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                    <ColumnDefinition Width="Auto"></ColumnDefinition>
                </Grid.ColumnDefinitions>

                <!-- Иконка -->
                <Image Source="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=Icon}"  
                       VerticalAlignment="Center"
                       Margin="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=(WindowChrome.WindowChrome).ResizeBorderThickness}"
                       WindowChrome.IsHitTestVisibleInChrome="True">
                </Image>
                
                <!-- Название окна -->
                <TextBlock Grid.ColumnSpan="5"
                           Text="{Binding RelativeSource={RelativeSource TemplatedParent},Path=Title}"   
                           VerticalAlignment="Center"
                           HorizontalAlignment="Center"
                           FontSize="16"
                           FontWeight="Bold"
                           Foreground="{DynamicResource WindowTitleForeground}">
                </TextBlock>

                <!-- Кнопка сворачивания окна -->
                <Button Name="minButton"
                        Grid.Column="2"
                        Content="{StaticResource MinimizePathData}"
                        Command="{x:Static SystemCommands.MinimizeWindowCommand}"
                        Style="{StaticResource WindowButtonBase}"
                        Template="{StaticResource WindowAppButton}">
                </Button>

                <!-- Кнопка разворачивания окна -->
                <Button Name="maxButton"
                        Grid.Column="3"
                        Content="{Binding RelativeSource={RelativeSource TemplatedParent}, Path=MaximizeButtonsData}"  
                        Command="{x:Static SystemCommands.MaximizeWindowCommand}"
                        Style="{StaticResource WindowButtonBase}"
                        Template="{StaticResource WindowAppButton}">
                </Button>

                <!-- Кнопка закрытия окна -->
                <Button Grid.Column="4"
                        Content="{StaticResource ClosePathData}"
                        Command="{x:Static SystemCommands.CloseWindowCommand}"
                        Template="{StaticResource WindowAppButton}">
                    <Button.Style>
                        <Style TargetType="Button" BasedOn="{StaticResource WindowButtonBase}">
                            <Style.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter Property="Background" Value="Red"/>
                                    <Setter Property="Foreground" Value="White"/>
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </Button.Style>
                </Button>
            </Grid>
            
            <!-- Содержимое окна -->
            <Border Grid.Row="1" Margin="{TemplateBinding Margin}">
                <ContentPresenter Content="{TemplateBinding Content}"/>
            </Border>
        </Grid>

        <ControlTemplate.Triggers>
            <Trigger Property="ShowMinMaxButtons" Value="False">
                <Setter TargetName="minButton" Property="Visibility" Value="Hidden"/>
                <Setter TargetName="maxButton" Property="Visibility" Value="Hidden"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон для изменения цвета текста в соответствии с приоритетом -->
    <Style TargetType="TextBlock" BasedOn="{StaticResource BaseStyleAlignment}" x:Key="TaskItemWithTextIndication">
        <Style.Triggers>
            <DataTrigger Binding="{Binding Source={x:Static model:Settings.Instanse},Path=IndicateByPriority}" Value="True">
                <Setter Property="Foreground" Value="{Binding Path=TaskPriority.Foreground}"></Setter>
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!-- Шаблон для всех TextBox'ов -->
    <ControlTemplate TargetType="TextBox" x:Key="TextBoxTemplate">
        <Border x:Name="border"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                SnapsToDevicePixels="True">
            <ScrollViewer x:Name="PART_ContentHost"
                          Focusable="false"
                          HorizontalScrollBarVisibility="Hidden"
                          VerticalScrollBarVisibility="Hidden">
            </ScrollViewer>
        </Border>
        <ControlTemplate.Triggers>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"></Condition>
                    <Condition Property="IsReadOnly" Value="True"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource FieldIsMouseOverBorderReadOnly}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsMouseOver" Value="True"></Condition>
                    <Condition Property="IsReadOnly" Value="False"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource FieldIsMouseOverBorder}"/>
            </MultiTrigger>

            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsFocused" Value="True"></Condition>
                    <Condition Property="IsReadOnly" Value="True"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="border" Value="{DynamicResource FieldIsFocusedBorderReadOnly}"/>
            </MultiTrigger>
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="IsFocused" Value="True"></Condition>
                    <Condition Property="IsReadOnly" Value="False"></Condition>
                </MultiTrigger.Conditions>
                <Setter Property="BorderBrush" TargetName="border" Value="{StaticResource FieldIsFocusedBorder}"/>
            </MultiTrigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон элемента списка (основной раздел) 
         А также для элементов списка комбобоксов -->
    <ControlTemplate TargetType="ListBoxItem" x:Key="ListBoxItemTemplate">
        <Border x:Name="listBoxItemBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Margin="{TemplateBinding Margin}"
                Height="{TemplateBinding Height}"
                Width="{TemplateBinding Width}">
            <Border x:Name="selectionBackground"
                    Background="Transparent"
                    BorderThickness="0"
                    Opacity="1">
                <ContentControl HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                                VerticalAlignment="{TemplateBinding VerticalAlignment}"
                                Foreground="{TemplateBinding Foreground}"
                                Content="{TemplateBinding Content}"
                                ContentTemplate="{TemplateBinding ContentTemplate}">
                </ContentControl>
            </Border>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="selectionBackground" Property="Background" Value="{StaticResource TaskItemIsMouseOverBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{StaticResource TaskItemIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="selectionBackground" Property="Background" Value="{StaticResource TaskItemIsSelectedBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{DynamicResource TaskItemIsSelectedBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон кнопки-экспандера элемента дерева -->
    <ControlTemplate TargetType="ToggleButton" x:Key="ExpanderTreeButton">
        <Grid Width="15" Height="13" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Collapsed" Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Expanded" Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Unchecked" />

                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Значок при скрытии потомков -->
            <Path x:Name="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1" Data="M 4 0 L 8 4 L 4 8 Z"
                  Fill="{DynamicResource AntiMainColor}">
            </Path>

            <!-- Значок при показе потомков -->
            <Path x:Name="Expanded" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1" Data="M 0 4 L 8 4 L 4 8 Z" Visibility="Hidden" 
                  Fill="{DynamicResource AntiMainColor}">
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- Шаблон элемента дерева (неосновной раздел) -->
    <ControlTemplate TargetType="ctrl:StretchingTreeViewItem" x:Key="TreeViewItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="19" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Менеджер визуальных состояний -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="selectionBackground" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource TaskItemIsSelectedBackground}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="borderItem" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{DynamicResource TaskItemIsSelectedBorder}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <!-- Добавлено, чтобы происходил сброс -->
                    <VisualState x:Name="Unselected" />

                    <!-- Чтобы не происходило сброса при смене фокуса -->
                    <!--<VisualState x:Name="SelectedInactive" />-->
                </VisualStateGroup>

                <VisualStateGroup x:Name="ExpansionStates">
                    <VisualState x:Name="Expanded">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="itemsHost" Storyboard.TargetProperty="(UIElement.Visibility)">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Collapsed"></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Кнопка-экспандер -->
            <ToggleButton x:Name="expander"
                          Focusable="False"
                          Template="{StaticResource ExpanderTreeButton}"
                          ClickMode="Press"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- Рамка, в которой содержится заголовок родителя -->
            <Border x:Name="borderItem"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5"
                    Padding="{TemplateBinding Padding}">
                <Border x:Name="selectionBackground"
                        Background="Transparent"
                        BorderThickness="0"
                        Opacity="1">
                    <ContentPresenter x:Name="PART_Header"
                                      ContentSource="Header"
                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                    </ContentPresenter>
                </Border>
                
            </Border>

            <!-- Дочерние элементы -->
            <ItemsPresenter x:Name="itemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <!-- Если родитель пустой, то скрываем кнопку-экспандер -->
            <Trigger Property="HasItems" Value="false">
                <Setter TargetName="expander" Property="Visibility" Value="Hidden" />
            </Trigger>

            <!-- Мультитриггер для задания минимальной ширины -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Width" Value="Auto" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>

            <!-- Мультитриггер для задания минимальной высоты -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Height" Value="Auto" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>

            <!-- Не задаём в менеджере визуальных состояний, чтобы обработать отключение родителей (они выделяются, если выделяется дочерний элемент) -->
            <Trigger Property="h:TreeViewHelper.IsMouseDirectlyOverItem" Value="True">
                <Setter TargetName="selectionBackground" Property="Background" Value="{StaticResource TaskItemIsSelectedBackground}" />
                <Setter TargetName="borderItem" Property="BorderBrush" Value="{DynamicResource TaskItemIsSelectedBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон отображаемой части комбобокса -->
    <ControlTemplate TargetType="ToggleButton" x:Key="ToggleButtonComboBoxTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="5*" />
                <ColumnDefinition Width="*" MaxWidth="20"/>
            </Grid.ColumnDefinitions>
            <Border x:Name="mainBorder" Grid.ColumnSpan="2"
                    Background="{DynamicResource FieldBackground}"
                    BorderBrush="{StaticResource DefaultBorder}"
                    BorderThickness="1">
            </Border>
            <Path Grid.Column="1"
                  Stroke="{DynamicResource AntiMainColor}"
                  HorizontalAlignment="Center"
                  VerticalAlignment="Center"
                  Data="M 0 0 L 0 1 L 3 3 L 6 1 L 6 0 L 3 2.5 Z"/>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="ToggleButton.IsMouseOver" Value="True">
                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource FieldIsMouseOverBorder}"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsChecked" Value="True">
                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{StaticResource FieldIsFocusedBorder}"/>
            </Trigger>
            <Trigger Property="ToggleButton.IsEnabled" Value="False">
                <Setter TargetName="mainBorder" Property="Background" Value="{DynamicResource FieldBackgroundReadOnly}"/>
                <Setter TargetName="mainBorder" Property="BorderBrush" Value="{DynamicResource FieldIsFocusedBorderReadOnly}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон всего комбобокса (с выпадающим списком) -->
    <ControlTemplate TargetType="ComboBox" x:Key="ComboBoxTemplate">
        <Grid>
            <ToggleButton Focusable="false"
                          Template="{StaticResource ToggleButtonComboBoxTemplate}"
                          IsChecked="{Binding RelativeSource={RelativeSource TemplatedParent},Path=IsDropDownOpen,Mode=TwoWay}">
            </ToggleButton>
            <ContentPresenter Name="ContentSite" IsHitTestVisible="False"
                              Content="{TemplateBinding SelectionBoxItem}"
                              ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                              ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}"
                              Margin="3">
            </ContentPresenter>

            <!-- Если нужна возможность ввода данных -->
            <!--<TextBox Visibility="Hidden" IsReadOnly="{TemplateBinding IsReadOnly}"/>-->

            <Popup Name="Popup"
                   Placement="Bottom"
                   IsOpen="{TemplateBinding IsDropDownOpen}"
                   AllowsTransparency="True"
                   Focusable="False"
                   PopupAnimation="Slide">
                <Grid SnapsToDevicePixels="True"
                      MinWidth="{TemplateBinding ActualWidth}"
                      MaxHeight="{TemplateBinding MaxDropDownHeight}"
                      Background="{DynamicResource InnerBackground}">
                    <Border BorderThickness="1" BorderBrush="Black"></Border>
                    <ScrollViewer SnapsToDevicePixels="True">
                        <StackPanel IsItemsHost="True" />
                    </ScrollViewer>
                </Grid>
            </Popup>
        </Grid>
    </ControlTemplate>

    <!-- Шаблон для всех чекбоксов -->
    <ControlTemplate TargetType="ctrl:CheckBoxWithItemStyle" x:Key="CheckBoxTemplate">
        <StackPanel Orientation="Horizontal" VerticalAlignment="{TemplateBinding VerticalAlignment}" HorizontalAlignment="Stretch" >
            <Border Style="{StaticResource BaseScale}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    Background="{TemplateBinding Background}"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Margin="{TemplateBinding Margin}"
                    Width="14"
                    Height="14">
                <Grid>
                    <Grid Name="nullBlock"
                          Background="{TemplateBinding Foreground}"
                          Visibility="Collapsed" />
                    <Path Name="eliCheck"
                          Stretch="Uniform"
                          Width="15"
                          Height="10"
                          Fill="{TemplateBinding Foreground}"
                          Data="F1 M 9.3,1.14 L 4.39,8.49 L 4.22,8.49 L 0,4.85 L 1.19,3.29 L 3.97,5.68 L 7.77,0 L 9.3,1.14 Z"
                          Visibility="Collapsed"/>
                    <!--Data="F1 M 9.97498,1.22334 L 4.6983,9.09834 L 4.52164,9.09834 L 0,5.19331 L 1.27664,3.52165 L 4.255,6.08833 L 8.33331,0 L 9.97498,1.22334 Z"-->
                </Grid>
            </Border>
            <TextBlock Style="{Binding RelativeSource={RelativeSource TemplatedParent},Path=TextBlockStyle,Mode=TwoWay}" Text="{TemplateBinding Content}"></TextBlock>
        </StackPanel>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsMouseOverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource FieldBackgroundReadOnly}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FieldIsFocusedBorderReadOnly}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="eliCheck" Property="Visibility" Value="Visible"></Setter>
            </Trigger>
            <Trigger Property="IsChecked" Value="{x:Null}">
                <Setter TargetName="nullBlock" Property="Visibility" Value="Visible"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон для кнопок (общий) -->
    <ControlTemplate TargetType="Button" x:Key="ButtonTemplate">
        <Border x:Name="serviceButtonBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Height="{TemplateBinding Height}"
                Width="{TemplateBinding Width}" >
            <ContentControl HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Margin="5,0,5,0"
                            Content="{TemplateBinding Content}">
            </ContentControl>
        </Border>
    </ControlTemplate>

    <!-- Шаблон для "статических" кнопок меню в боковой панели -->
    <ControlTemplate TargetType="Button" x:Key="MenuButtonTemplate">
        <Border x:Name="menuButtonBorder"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Background="{TemplateBinding Background}"
                Margin="{TemplateBinding Margin}"
                Height="{TemplateBinding Height}"
                Width="{TemplateBinding Width}" >
            <ContentControl HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                            VerticalAlignment="{TemplateBinding VerticalAlignment}"
                            Content="{TemplateBinding Content}">
            </ContentControl>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="menuButtonBorder" Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон для заголовков вкладок (общий) -->
    <ControlTemplate TargetType="TabItem" x:Key="TabItemTemplate">
        <Border Background="{TemplateBinding Background}"
                BorderBrush="{TemplateBinding BorderBrush}"
                BorderThickness="{TemplateBinding BorderThickness}"
                Padding="{TemplateBinding Padding}">
            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              ContentSource="Header"/>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsMouseOverBackground}"></Setter>
            </Trigger>
            <Trigger Property="IsSelected" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsPressedBackground}"></Setter>
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон элемента контекстного меню (общий) -->
    <ControlTemplate TargetType="MenuItem" x:Key="ContextMenuItemTemplate">
        <Border x:Name="itemBorder"
            Padding="27,0,17,0"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            SnapsToDevicePixels="True">
            <ContentPresenter Content="{TemplateBinding Header}"
                          ContentSource="Header"
                          Margin="{TemplateBinding Padding}"
                          RecognizesAccessKey="True"
                          SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}">
            </ContentPresenter>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Foreground" Value="Gray"></Setter>
            </Trigger>
            <Trigger Property="IsHighlighted" Value="True">
                <Setter TargetName="itemBorder" Property="Background" Value="{StaticResource MenuItemIsMouseOverBackground}"/>
                <Setter TargetName="itemBorder" Property="BorderBrush" Value="{StaticResource MenuItemIsMouseOverBorder}"/>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон контекстного меню (общий) -->
    <ControlTemplate TargetType="ContextMenu" x:Key="ContextMenuTemplate">
        <Border x:Name="border" Background="{TemplateBinding Background}" BorderThickness="1" BorderBrush="{StaticResource DefaultBorder}">
            <StackPanel ClipToBounds="True" Orientation="Vertical" IsItemsHost="True" Margin="5,4,5,4" />
        </Border>
    </ControlTemplate>

    <!-- Шаблон для всех радиокнопок -->
    <ControlTemplate TargetType="RadioButton" x:Key="RadioButtonTemplate">
        <BulletDecorator Background="Transparent">
            <BulletDecorator.Bullet>
                <Grid Width="13" Height="13">
                    <Ellipse x:Name="Border"
                             StrokeThickness="1"
                             Stroke="{TemplateBinding BorderBrush}"
                             Fill="{TemplateBinding Background}">
                    </Ellipse>
                    <Ellipse x:Name="CheckMark"
                             Margin="4"
                             Visibility="Collapsed"
                             Fill="{TemplateBinding Foreground}">
                    </Ellipse>
                </Grid>
            </BulletDecorator.Bullet>
            <ContentPresenter Margin="4,0,0,0"
                              VerticalAlignment="Center"
                              HorizontalAlignment="Left"
                              RecognizesAccessKey="True">
            </ContentPresenter>
        </BulletDecorator>

        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsMouseOverBackground}" />
                <Setter Property="BorderBrush" Value="{DynamicResource ButtonIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Setter Property="Background" Value="{DynamicResource ButtonIsPressedBackground}" />
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Background" Value="{DynamicResource FieldBackgroundReadOnly}" />
                <Setter Property="BorderBrush" Value="{DynamicResource FieldIsFocusedBorderReadOnly}"/>
            </Trigger>
            <Trigger Property="IsChecked" Value="True">
                <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"></Setter>
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон для всех группбоксов -->
    <ControlTemplate TargetType="GroupBox" x:Key="GroupBoxTemplate">
        <Grid SnapsToDevicePixels="true">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="6"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="6"/>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
                <RowDefinition Height="6"/>
            </Grid.RowDefinitions>

            <!-- Промежуточный фон -->
            <Border Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="4"
                    BorderBrush="Transparent"
                    BorderThickness="{TemplateBinding BorderThickness}"
                    Background="{TemplateBinding Background}"
                    CornerRadius="4"  />

            <!-- Внешняя обводка (выключаем) -->
            <Border Grid.Row="1" Grid.RowSpan="3" Grid.ColumnSpan="4"
                    BorderBrush="Green"
                    BorderThickness="0"
                    CornerRadius="4">
                <Border.OpacityMask>
                    <MultiBinding ConverterParameter="7">
                        <MultiBinding.Converter>
                            <BorderGapMaskConverter />
                        </MultiBinding.Converter>
                        <Binding ElementName="Header" Path="ActualWidth" />
                        <Binding RelativeSource="{RelativeSource Self}" Path="ActualWidth" />
                        <Binding RelativeSource="{RelativeSource Self}" Path="ActualHeight" />
                    </MultiBinding>
                </Border.OpacityMask>
                <!-- Основная граница -->
                <Border BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="3">
                    <!-- Внутренняя обводка (выключаем) -->
                    <Border BorderThickness="0" CornerRadius="2" />
                </Border>
            </Border>
            <!-- Хедер -->
            <Border x:Name="Header" Grid.Column="1" Grid.RowSpan="2" Padding="3,1,3,0" Background="Transparent" CornerRadius="2">
                <ContentPresenter ContentSource="Header" RecognizesAccessKey="True" SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
            </Border>
            <ContentPresenter Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                              VerticalAlignment="{TemplateBinding VerticalAlignment}"
                              Margin="{TemplateBinding Padding}"
                              SnapsToDevicePixels="{TemplateBinding SnapsToDevicePixels}"/>
        </Grid>
    </ControlTemplate>
    
</ResourceDictionary>