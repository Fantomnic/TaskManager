<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:v="clr-namespace:TaskManager.Views"
                    xmlns:h="clr-namespace:TaskManager.Helpers">

    <!-- Прим.: Если добавить словари друг в друга, будет переполнение стека -->
    <ResourceDictionary.MergedDictionaries>
        <ResourceDictionary Source="/Resources/Themes/GeneralThemesResources.xaml" />
    </ResourceDictionary.MergedDictionaries>

    <!-- Шаблон элемента списка (основной раздел) -->
    <ControlTemplate TargetType="ListBoxItem" x:Key="listBoxItemTemplate">
        <Border x:Name="listBoxItemBorder"
            BorderBrush="{TemplateBinding BorderBrush}"
            BorderThickness="{TemplateBinding BorderThickness}"
            Background="{TemplateBinding Background}"
            Margin="{TemplateBinding Margin}"
            Height="{TemplateBinding Height}"
            Width="{TemplateBinding Width}" >
            <ContentControl HorizontalAlignment="{TemplateBinding HorizontalAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalAlignment}">
                <ContentControl.Content>
                    <TextBlock Style="{StaticResource baseStyleAlignment}" Text="{Binding Path=Name}"/>
                </ContentControl.Content>
            </ContentControl>
        </Border>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="true">
                <Setter TargetName="listBoxItemBorder" Property="Background" Value="{StaticResource taskItemIsMouseOverBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{StaticResource taskItemIsMouseOverBorder}" />
            </Trigger>
            <Trigger Property="IsSelected" Value="true">
                <Setter TargetName="listBoxItemBorder" Property="Background" Value="{StaticResource taskItemIsSelectedBackground}" />
                <Setter TargetName="listBoxItemBorder" Property="BorderBrush" Value="{StaticResource taskItemIsSelectedBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!-- Шаблон кнопки-экспандера элемента дерева -->
    <ControlTemplate TargetType="ToggleButton" x:Key="expanderButton">
        <Grid Width="15" Height="13" Background="Transparent">
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="CheckStates">
                    <VisualState x:Name="Checked">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="Collapsed">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Hidden}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="Expanded">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Unchecked" />

                    <VisualState x:Name="Indeterminate" />
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Значок при скрытии потомков -->
            <Path x:Name="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1" Data="M 4 0 L 8 4 L 4 8 Z"
                  Fill="{DynamicResource antiMainColor}">
            </Path>

            <!-- Значок при показе потомков -->
            <Path x:Name="Expanded" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="1" Data="M 0 4 L 8 4 L 4 8 Z" Visibility="Hidden" 
                  Fill="{DynamicResource antiMainColor}">
            </Path>
        </Grid>
    </ControlTemplate>

    <!-- Шаблон элемента дерева (неосновной раздел) -->
    <ControlTemplate TargetType="v:StretchingTreeViewItem" x:Key="treeViewItemTemplate">
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition MinWidth="19" Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition />
            </Grid.RowDefinitions>

            <!-- Менеджер визуальных состояний -->
            <VisualStateManager.VisualStateGroups>
                <VisualStateGroup x:Name="SelectionStates">
                    <VisualState x:Name="Selected">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="Background">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource taskItemIsSelectedBackground}" />
                            </ObjectAnimationUsingKeyFrames>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetName="Bd" Storyboard.TargetProperty="BorderBrush">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{StaticResource taskItemIsSelectedBorder}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <!-- Добавлено, чтобы происходил сброс -->
                    <VisualState x:Name="Unselected" />

                    <!-- Чтобы не происходило сброса при смене фокуса -->
                    <!--<VisualState x:Name="SelectedInactive" />-->
                </VisualStateGroup>

                <VisualStateGroup x:Name="ExpansionStates">
                    <VisualState x:Name="Expanded">
                        <Storyboard>
                            <ObjectAnimationUsingKeyFrames Storyboard.TargetProperty="(UIElement.Visibility)" Storyboard.TargetName="ItemsHost">
                                <DiscreteObjectKeyFrame KeyTime="0" Value="{x:Static Visibility.Visible}" />
                            </ObjectAnimationUsingKeyFrames>
                        </Storyboard>
                    </VisualState>

                    <VisualState x:Name="Collapsed"></VisualState>
                </VisualStateGroup>
            </VisualStateManager.VisualStateGroups>

            <!-- Кнопка-экспандер -->
            <ToggleButton x:Name="Expander"
                          Focusable="False"
                          Template="{StaticResource expanderButton}"
                          ClickMode="Press"
                          IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}}" />

            <!-- Рамка, в которой содержится заголовок родителя -->
            <Border x:Name="Bd"
                    Grid.Column="1"
                    Background="{TemplateBinding Background}"
                    BorderBrush="{TemplateBinding BorderBrush}"
                    BorderThickness="1.5"
                    Padding="{TemplateBinding Padding}">
                <ContentPresenter x:Name="PART_Header"
                                  ContentSource="Header"
                                  HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}">
                </ContentPresenter>
            </Border>

            <!-- Дочерние элементы -->
            <ItemsPresenter x:Name="ItemsHost" Grid.Row="1" Grid.Column="1" Grid.ColumnSpan="2" Visibility="Collapsed" />
        </Grid>

        <ControlTemplate.Triggers>
            <!-- Если родитель пустой, то скрываем кнопку-экспандер -->
            <Trigger Property="HasItems" Value="false">
                <Setter TargetName="Expander" Property="Visibility" Value="Hidden" />
            </Trigger>

            <!-- Мультитриггер для задания минимальной ширины -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Width" Value="Auto" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Header" Property="MinWidth" Value="75" />
            </MultiTrigger>

            <!-- Мультитриггер для задания минимальной высоты -->
            <MultiTrigger>
                <MultiTrigger.Conditions>
                    <Condition Property="HasHeader" Value="false" />
                    <Condition Property="Height" Value="Auto" />
                </MultiTrigger.Conditions>
                <Setter TargetName="PART_Header" Property="MinHeight" Value="19" />
            </MultiTrigger>

            <!-- Не задаём в менеджере визуальных состояний, чтобы обработать отключение родителей (они выделяются, если выделяется дочерний элемент) -->
            <Trigger Property="h:TreeViewHelper.IsMouseDirectlyOverItem" Value="True">
                <Setter TargetName="Bd" Property="Background" Value="{StaticResource taskItemIsSelectedBackground}" />
                <Setter TargetName="Bd" Property="BorderBrush" Value="{StaticResource taskItemIsSelectedBorder}" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

</ResourceDictionary>