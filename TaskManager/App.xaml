<Application x:Class="TaskManager.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="clr-namespace:TaskManager"
             StartupUri="/Views/MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="/Resources/Themes/LightTheme.xaml" />
                <ResourceDictionary Source="/Resources/InterfaceResources.xaml" />
                <ResourceDictionary Source="/Resources/TextsResources.xaml" />
                <ResourceDictionary Source="/Resources/WindowsResources.xaml" />
                <ResourceDictionary Source="/Resources/Instances.xaml" />
                <ResourceDictionary Source="/Resources/TasksAndSectionsResources.xaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>
</Application>
