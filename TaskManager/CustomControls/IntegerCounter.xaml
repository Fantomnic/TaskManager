<UserControl x:Class="TaskManager.CustomControls.IntegerCounter"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:TaskManager.CustomControls"
             mc:Ignorable="d">

    <UserControl.Resources>
        <Style TargetType="Button" BasedOn="{StaticResource ServiceButton}" x:Key="CounterButton">
            <Setter Property="Margin" Value="0"></Setter>
            <Setter Property="MinHeight" Value="0"></Setter>
            <Setter Property="MinWidth" Value="0"></Setter>
        </Style>
    </UserControl.Resources>
    
    <Border x:Name="border" Background="{DynamicResource FieldBackground}" BorderBrush="Blue" BorderThickness="1"
            MouseEnter="BorderMouseEnter" MouseLeave="BorderMouseLeave" GotFocus="BorderGotFocus" LostFocus="BorderLostFocus">
        <Grid Margin="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition></ColumnDefinition>
                <ColumnDefinition Width="20"></ColumnDefinition>
            </Grid.ColumnDefinitions>
            <Grid.RowDefinitions>
                <RowDefinition Height="*"></RowDefinition>
                <RowDefinition Height="*"></RowDefinition>
            </Grid.RowDefinitions>

            <TextBox x:Name="digitalText" Grid.RowSpan="2" Style="{StaticResource BaseTextBoxAlignment}" BorderThickness="0" MinWidth="35" Background="Transparent"
                     SizeChanged="DigitalTextSizeChanged" TextChanged="DigitalTextTextChanged" Loaded="OnLoaded">
            </TextBox>
            <Button x:Name="upButton" Grid.Column="1" Style="{StaticResource CounterButton}" Click="UpClick">
                <Button.Content>
                    <Path Data="M 0 0 L 12 0 L 6 -2 Z" Fill="{DynamicResource TextForeground}" Stretch="Fill" Margin="-1 1.75 -1 1.75"></Path>
                </Button.Content>
            </Button>
            <Button x:Name="downButton" Grid.Column="1" Grid.Row="1" Style="{StaticResource CounterButton}" Click="DownClick">
                <Button.Content>
                    <Path Data="M 0 0 L 12 0 L 6 2 Z" Fill="{DynamicResource TextForeground}" Stretch="Fill" Margin="-1 1.75 -1 1.75"></Path>
                </Button.Content>
            </Button>
        </Grid>
    </Border>
</UserControl>
